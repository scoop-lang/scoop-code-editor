package scoop.ui.editor

import scoop.graphics.text.TextPosition
import scoop.window.Utf8Range

internal fun adjacentGrapheme(doc: CodeDocument, offset: Long, forward: Boolean): Long {
    val pos = doc.positionAt(offset)
    val range = doc.lineRange(pos.line)
    if (forward && offset >= range.end) return doc.lineRange(pos.line, true).end
    if (!forward && offset > range.end) return range.end
    if (!forward && offset == range.start) {
        if (pos.line == 0L) return 0L
        return doc.lineRange(pos.line - 1L).end
    }
    val boundaries = graphemeOffsets(doc.read(range))
    var previous = range.start
    for (boundary in boundaries) {
        val current = range.start + boundary
        if (forward && current > offset) return current
        if (!forward && current >= offset) return previous
        previous = current
    }
    return range.end
}

public fun CodeEditorState.moveHorizontal(forward: Boolean, extend: Boolean = false) {
    val input = selections
    val output = ArrayList<CodeSelection>()
    for (s in input.values) {
        val range = s.range
        val next = if (!extend && range.start != range.end) {
            TextPosition(if (forward) range.end else range.start)
        } else
            stepGrapheme(s.cursor, forward)
        val cursor = folding.visibleDestination(s.cursor, next)
        output.add(CodeSelection(if (extend) s.anchor else cursor, cursor))
    }
    setSelections(output, input.primaryIndex)
}

public fun CodeEditorState.moveToLineEdge(end: Boolean, extend: Boolean = false) {
    val input = selections
    val output = ArrayList<CodeSelection>()
    for (s in input.values) {
        val line = document.lineRange(document.positionAt(s.cursor.byteOffset).line)
        val cursor = TextPosition(if (end) line.end else line.start)
        output.add(CodeSelection(if (extend) s.anchor else cursor, cursor))
    }
    setSelections(output, input.primaryIndex)
}

public fun CodeEditorState.selectAll() {
    setSelections([CodeSelection.offsets(0L, document.byteLength)])
}

internal fun CodeEditorState.replaceEach(
    kind: CodeEditKind,
    text: (CodeSelection) -> String
): CodeEditResult {
    val before = selections
    val edits = Array<CodeEdit>(before.values.size) { i ->
        CodeEdit(before.values[i].range, text(before.values[i]))
    }
    return executeEdits(
        document.version,
        edits,
        Some(
            { map ->
                CodeSelections(
                    Array<CodeSelection>(edits.size) { i ->
                        CodeSelection.caret(map.insertedRange(i).end)
                    },
                    before.primaryIndex
                )
            }
        ),
        kind
    )
}

public fun CodeEditorState.replaceSelections(
    text: String,
    kind: CodeEditKind = CodeEditKind.Typing
): CodeEditResult = replaceEach(kind) { _ -> text }

public fun CodeEditorState.insertNewline(): CodeEditResult {
    val rule = document.language?.enter ?: None
    when (rule) {
        case Some(val applyRule) -> return ruleNewline(applyRule);
        case None -> {}
    }
    return replaceEach(CodeEditKind.Command) { selection ->
        val doc = document
        val offset = selection.range.start
        val line = doc.positionAt(offset).line
        val prefix = doc.indentRange(line)
        return@replaceEach doc.endingAt(line) +
            doc.read(Utf8Range(prefix.start, if (offset < prefix.end) offset else prefix.end))
    }
}

public fun CodeEditorState.deleteGrapheme(forward: Boolean): CodeEditResult {
    val edits = ArrayList<CodeEdit>()
    for (s in selections.values) {
        var r = s.range
        if (r.start == r.end) {
            val offset = if (forward)
                adjacentGrapheme(document, r.start, true)
            else
                backspaceStart(r.start)
            r = if (forward)
                Utf8Range(r.start, offset)
            else
                generatedDeletion(r.start) ?: Utf8Range(offset, r.start)
        }
        if (r.start == r.end) continue
        val i = edits.size - 1L
        if (i >= 0L && edits[i].range.end > r.start) {
            val old = edits[i].range
            edits[i] = CodeEdit(Utf8Range(old.start, if (old.end > r.end) old.end else r.end), "")
        } else
            edits.add(CodeEdit(r, ""))
    }
    return executeEdits(
        document.version,
        edits,
        None,
        if (forward) CodeEditKind.DeleteForward else CodeEditKind.Backspace
    )
}

public fun CodeEditorState.selectedText(): String {
    val out = StringBuilder()
    for (i in 0L..<selections.values.size) {
        if (i > 0L) out.append("\n")
        out.append(document.read(selections.values[i].range))
    }
    return out.toString()
}
