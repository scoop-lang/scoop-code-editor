package scoop.ui.editor

import scoop.collections.HashMap
import scoop.graphics.*
import scoop.graphics.text.TextPosition
import scoop.ui.*
import scoop.ui.component.ItemExtentIndex
import scoop.ui.component.nativeContextMenu
import scoop.ui.style.Theme
import scoop.ui.style.ThemeSource
import scoop.ui.style.read
import scoop.ui.style.shadcn.shadcnTheme

internal class WidgetLayout(
    val ink: EditorInk,
    val context: MeasureContext,
    val size: Size,
    val gutter: Double,
    val doc: CodeSnapshot,
    val folds: FoldProjection
) {
    internal val zones = HashMap<Long, Double>()
    internal val before = HashMap<Long, Double>()
    private val heights = HashMap<Long, Double>()
    private val lines = HashMap<Long, Long>()
    private val items = ink.contents.widgets
    private val body = if (size.width > gutter) size.width - gutter else 0.0

    init {
        for (i in 0L..<items.size) {
            val w = items[i]
            when (w.kind) {
                case Zone(val side) -> {
                    val offset = ink.input.previewMap?.map(w.offset) ?: w.offset
                    val line = doc.positionAt(offset).line
                    if (folds.hidden(line)) continue
                    val measured = context
                        .measureChild(i, Constraints(minWidth = body, maxWidth = Some(body)))
                    heights.put(i, measured.size.height)
                    lines.put(i, line)
                    zones.put(line, (zones[line] ?: 0.0) + measured.size.height)
                    if (side == CodeZoneSide.Before)
                        before.put(line, (before[line] ?: 0.0) + measured.size.height)
                }

                else -> {}
            }
        }
    }

    private fun placeChild(frame: EditorFrame, index: Long, rect: Rect) {
        context.placeChild(index, Point(rect.x, rect.y))
        if (rect.y +
            rect.height >
            0.0 &&
            rect.y <
            size.height &&
            rect.x +
            rect.width >
            0.0 &&
            rect.x <
            size.width
        )
            frame.placedWidgets.add(PositionedWidget(items[index], rect))
    }

    internal fun place(frame: EditorFrame, index: ItemExtentIndex) {
        val placedBefore = HashMap<Long, Double>()
        val placedAfter = HashMap<Long, Double>()
        for (i in 0L..<items.size) {
            val widget = items[i]
            when (widget.kind) {
                case Zone(val side) -> {
                    val line = lines[i]
                    if (line == None) {
                        context.skipChild(i);
                        continue
                    }
                    val logical = line!!
                    val placed = if (side == CodeZoneSide.Before) placedBefore else placedAfter
                    val extent = heights[i] ?: 0.0
                    val consumed = placed[logical] ?: 0.0
                    val indexInView = folds.index(logical)
                    val top = if (side == CodeZoneSide.Before)
                        index.prefix(indexInView)
                    else
                        index.prefix(indexInView + 1L) -
                            (zones[logical] ?: 0.0) +
                            (before[logical] ?: 0.0)
                    val y = top + consumed - frame.origin.y
                    placeChild(frame, i, Rect(gutter, y, body, extent))
                    placed.put(logical, consumed + extent)
                }

                case Content -> {
                    val position = frame.displayPosition(TextPosition(widget.offset))
                    val caret = ink.clippedCaret(frame, position)
                    when (caret) {
                        case None -> context.skipChild(i)

                        case Some(val rect) -> {
                            val metrics = context
                                .measureChild(
                                    i,
                                    Constraints(
                                        maxWidth = Some(body),
                                        maxHeight = Some(size.height)
                                    )
                                )
                            val x = if (rect.x + metrics.size.width > size.width)
                                size.width - metrics.size.width
                            else
                                rect.x
                            val y = if (rect.y + rect.height + metrics.size.height <= size.height)
                                rect.y + rect.height
                            else
                                rect.y - metrics.size.height
                            placeChild(
                                frame,
                                i,
                                Rect(
                                    x,
                                    if (y > 0.0) y else 0.0,
                                    metrics.size.width,
                                    metrics.size.height
                                )
                            )
                        }
                    }
                }

                case Overlay(val corner) -> {
                    val metrics = context
                        .measureChild(
                            i,
                            Constraints(maxWidth = Some(size.width), maxHeight = Some(size.height))
                        )
                    val x = if (corner ==
                        CodeEditorCorner.TopRight ||
                        corner ==
                        CodeEditorCorner.BottomRight
                    )
                        size.width - metrics.size.width
                    else
                        0.0
                    val y = if (corner ==
                        CodeEditorCorner.BottomLeft ||
                        corner ==
                        CodeEditorCorner.BottomRight
                    )
                        size.height - metrics.size.height
                    else
                        0.0
                    placeChild(frame, i, Rect(x, y, metrics.size.width, metrics.size.height))
                }
            }
        }
    }
}

internal class EditorContents(
    val state: CodeEditorState,
    val widgets: Array<EditorWidget>,
    val theme: Theme,
    val themes: ThemeSource
)

internal fun CodeEditorState.uiTheme(): ThemeSource = mounted?.contents?.themes ?:
    contextOrNone<ThemeSource>() ?:
    ThemeSource(shadcnTheme())

internal class EditorComponent(val input: Props<CodeEditorState>, scope: ComponentScope) :
    Component(scope) {
    private val themes = contextOrNone<ThemeSource>() ?: ThemeSource(shadcnTheme())
    public override fun render(): View {
        val state = input.value
        val widgets = state.widgetList.value
        val children = Array<View>(widgets.size) { i ->
            val widget = widgets[i]
            element({ mount -> WidgetSlot(mount) }, [widget.view], ViewKey.Number(widget.id))
        }
        val body = element(
            EditorContents(state, widgets, themes.read(scope), themes),
            { props, mount -> EditorInk(props, mount) },
            children
        )
        return nativeContextMenu(body, state.nativeEditMenu())
    }
}

private class WidgetSlot(scope: ComponentScope) : Element<Unit>(scope) {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val metrics = context.measureChild(0L, constraints)
        context.placeChild(0L, Point(0.0, 0.0))
        return LayoutResult(metrics, Unit)
    }
    public override fun scene(context: SceneContext, layout: Unit) {
        context.children()
    }
}
