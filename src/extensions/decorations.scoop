package scoop.ui.editor

import scoop.collections.*
import scoop.comparisons.comparatorOf
import scoop.graphics.Color
import scoop.graphics.text.SpanStyle
import scoop.window.Utf8Range

public struct CodeDecorationStyle(
    val foreground: Color? = None,
    val background: Color? = None,
    val underline: Color? = None,
    val gutter: Color? = None,
    val wholeLine: Color? = None,
    val glyph: CodeGutterGlyph? = None,
    val font: SpanStyle? = None,
    val before: CodeInlayText? = None,
    val after: CodeInlayText? = None
)

public struct CodeDecoration(
    val range: Utf8Range,
    val style: CodeDecorationStyle,
    val startBias: CodeStickiness = CodeStickiness.After,
    val endBias: CodeStickiness = CodeStickiness.Before
)

internal enum DecorationUpdate {
    Paint, Paragraph, Metrics
}

private fun decorationUpdate(values: List<CodeDecoration>): DecorationUpdate {
    var update = DecorationUpdate.Paint
    for (value in values) {
        val style = value.style
        if (style.before?.label != None || style.after?.label != None)
            return DecorationUpdate.Metrics
        when (val font = style.font) {
            case Some(val f) -> {
                if (f.families?.size !=
                    None ||
                    f.fontSize !=
                    None ||
                    f.weight !=
                    None ||
                    f.width !=
                    None ||
                    f.slant !=
                    None ||
                    f.locale !=
                    None ||
                    f.letterSpacing !=
                    None ||
                    f.wordSpacing !=
                    None ||
                    f.lineHeight !=
                    None ||
                    f.features?.size !=
                    None ||
                    f.variations?.size !=
                    None
                )
                    return DecorationUpdate.Metrics
                update = DecorationUpdate.Paragraph
            }

            case None -> if (style.foreground != None) update = DecorationUpdate.Paragraph
        }
    }
    return update
}

private class IndexedDecoration(val value: CodeDecoration, val order: Long, var maximumEnd: Long)

public class CodeDecorations internal constructor(private val store: DecorationStore) : Closeable {
    private var values: Array<CodeDecoration> = []
    private var sorted: Array<IndexedDecoration> = []
    internal var hasInlays = false
    private var closed = false
    private var update = DecorationUpdate.Paint

    public fun set(decorations: List<CodeDecoration>) {
        if (closed) throw IllegalStateException(Some("decoration collection is closed"))
        for (d in decorations) {
            if (!validRange(store.doc.root, d.range))
                throw IllegalArgumentException(Some("invalid decoration range"))
        }
        hasInlays = false
        for (d in decorations)
            if (d.style.before?.label != None || d.style.after?.label != None) {
                hasInlays = true;
                break
            }
        val old = update
        update = decorationUpdate(decorations)
        index(decorations.toArray())
        store
            .changed(
                if (old == DecorationUpdate.Metrics || update == DecorationUpdate.Metrics)
                    DecorationUpdate.Metrics
                else if (old == DecorationUpdate.Paragraph || update == DecorationUpdate.Paragraph)
                    DecorationUpdate.Paragraph
                else
                    DecorationUpdate.Paint
            )
    }

    private fun index(next: Array<CodeDecoration>) {
        val entries = ArrayList<IndexedDecoration>()
        for (i in 0L..<next.size)
            entries.add(IndexedDecoration(next[i], i, 0L))
        entries
            .sortWith(
                comparatorOf<IndexedDecoration> { a, b ->
                    a.value.range.start.compareTo(b.value.range.start)
                }
            )
        var end = 0L
        for (entry in entries) {
            if (entry.value.range.end > end) end = entry.value.range.end
            entry.maximumEnd = end
        }
        values = next
        sorted = entries.toArray()
    }

    internal fun map(mapping: CodeEditMap) {
        if (values.size == 0L) return
        index(
            Array<CodeDecoration>(values.size) { i ->
                val d = values[i]
                val a = mapping.map(d.range.start, d.startBias)
                val b = mapping.map(d.range.end, d.endBias)
                CodeDecoration(Utf8Range(a, if (b < a) a else b), d.style, d.startBias, d.endBias)
            }
        )
    }

    internal fun collect(range: Utf8Range, output: ArrayList<CodeDecoration>) {
        var low = 0L
        var high = sorted.size
        while (low < high) {
            val mid = (low + high) / 2L
            if (sorted[mid].maximumEnd < range.start) low = mid + 1L else high = mid
        }
        val intersecting = ArrayList<IndexedDecoration>()
        var i = low
        while (i < sorted.size) {
            val entry = sorted[i]
            val r = entry.value.range
            if (r.start > range.end) break
            if (r.end >= range.start) intersecting.add(entry)
            i += 1L
        }
        intersecting
            .sortWith(comparatorOf<IndexedDecoration> { a, b -> a.order.compareTo(b.order) })
        for (entry in intersecting)
            output.add(entry.value)
    }

    public fun clear() {
        set([])
    }
    public override fun close() {
        if (closed) return
        closed = true
        values = []
        sorted = []
        store.remove(this, update)
    }
}

internal class DecorationStore(val doc: CodeDocument, val changed: (DecorationUpdate) -> Unit) {
    private val collections = ArrayList<CodeDecorations>()
    internal val hasInlays: Boolean
        get() {
            for (group in collections)
                if (group.hasInlays) return true
            return false
        }
    internal fun create(): CodeDecorations {
        val group = CodeDecorations(this);
        collections.add(group);
        return group
    }
    internal fun map(mapping: CodeEditMap) {
        for (group in collections)
            group.map(mapping)
    }
    internal fun collect(range: Utf8Range, output: ArrayList<CodeDecoration>) {
        for (group in collections)
            group.collect(range, output)
    }
    internal fun remove(group: CodeDecorations, update: DecorationUpdate) {
        for (i in 0L..<collections.size) {
            if (collections[i] === group) {
                collections.removeAt(i);
                changed(update);
                return
            }
        }
    }
    internal fun close() {
        for (group in collections.toArray())
            group.close()
    }
}
