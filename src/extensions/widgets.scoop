package scoop.ui.editor

import scoop.ui.*
import scoop.window.Utf8Range

public enum CodeEditorCorner {
    TopLeft, TopRight, BottomLeft, BottomRight
}

public enum CodeZoneSide {
    Before, After
}

internal enum EditorWidgetKind {
    Content, Zone(val side: CodeZoneSide), Overlay(CodeEditorCorner)
}

internal class EditorWidget(
    val kind: EditorWidgetKind,
    var offset: Long,
    val view: View,
    val id: Long,
    val lenses: Array<LensEntry> = []
)

internal fun CodeEditorState.attachWidget(
    kind: EditorWidgetKind,
    offset: Long,
    view: View,
    lenses: Array<LensEntry> = []
): EditorWidget {
    if (closed || !scalarBoundary(document.root, offset))
        throw IllegalArgumentException(Some("invalid widget anchor or closed editor"))
    widgetId += 1L
    val widget = EditorWidget(kind, offset, view, widgetId, lenses)
    widgets.add(widget)
    return widget
}

internal fun CodeEditorState.detachWidget(widget: EditorWidget) {
    for (i in 0L..<widgets.size)
        if (widgets[i] === widget) {
            widgets.removeAt(i)
            return
        }
}

private fun CodeEditorState.addWidget(kind: EditorWidgetKind, offset: Long, view: View): Closeable {
    val widget = attachWidget(kind, offset, view)
    widgetList.value = widgets.toArray()
    return EditorRegistration {
        detachWidget(widget)
        widgetList.value = widgets.toArray()
    }
}

public fun CodeEditorState.remeasureWidgets() {
    if (!closed) widgetList.value = widgets.toArray()
}

public fun CodeEditorState.addContentWidget(position: Long, view: View): Closeable = addWidget(
    EditorWidgetKind.Content,
    position,
    view
)

public fun CodeEditorState.addOverlayWidget(corner: CodeEditorCorner, view: View): Closeable =
    addWidget(EditorWidgetKind.Overlay(corner), 0L, view)

public fun CodeEditorState.addViewZone(afterLine: Long, view: View): Closeable = addViewZone(
    afterLine,
    CodeZoneSide.After,
    view
)

public fun CodeEditorState.addViewZone(line: Long, side: CodeZoneSide, view: View): Closeable {
    val range = document.lineRange(line)
    return addWidget(
        EditorWidgetKind.Zone(side),
        if (side == CodeZoneSide.Before) range.start else range.end,
        view
    )
}

internal fun CodeEditorState.mapWidgets(mapping: CodeEditMap) {
    for (widget in widgets) {
        when (widget.kind) {
            case Content -> widget.offset = mapping.map(widget.offset)
            case Zone(val side) ->
                widget.offset = mapping
                    .map(
                        widget.offset,
                        if (side == CodeZoneSide.Before)
                            CodeStickiness.After
                        else
                            CodeStickiness.Before
                    )
            case Overlay(_) -> {}
        }
    }
}
