package scoop.ui.editor

import scoop.collections.HashMap
import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.component.*
import scoop.window.Utf8Range

internal class ReadingAnchor(
    val offset: Long,
    val screenY: Double,
    val request: ULong,
    val affinity: TextAffinity
)

internal fun positive(value: Double): Double = if (value > 1.0) value else 1.0

private struct ViewportCaret(
    val visual: Long,
    val x: Double,
    val localY: Double,
    val height: Double
) {
    fun top(index: ItemExtentIndex): Double = index.prefix(visual) + localY
}

private struct ViewportRows(val scroll: ScrollLayout, val first: Long, val end: Long)

private fun firstLayoutRow(index: ItemExtentIndex, y: Double): Long {
    val row = index.indexAt(if (y > 0.0) y else 0.0)
    return if (row > 0L) row - 1L else 0L
}

private fun measureViewportRows(
    index: ItemExtentIndex,
    height: Double,
    overscan: Double,
    measureRow: (Long) -> Unit,
    layoutScroll: () -> ScrollLayout
): ViewportRows {
    var scroll = layoutScroll()
    while (true) {
        val y = scroll.presentationOffset.y
        val first = firstLayoutRow(index, y)
        var end = first
        while (end < index.count && (end == first || index.prefix(end) <= y + height + overscan)) {
            measureRow(end)
            end += 1L
        }
        // Measuring wrapped lines can move the reading anchor or the bottom scroll limit.
        scroll = layoutScroll()
        val finalY = scroll.presentationOffset.y
        val finalFirst = firstLayoutRow(index, finalY)
        val bottom = finalY + height + overscan
        val last = index.indexAt(if (bottom > 0.0) bottom else 0.0)
        val finalEnd = if (last < index.count) last + 1L else index.count
        if (first <= finalFirst && finalEnd <= end)
            return ViewportRows(scroll, finalFirst, finalEnd)
    }
}

internal class CodeLayout(val ink: EditorInk) {
    private var index = ItemExtentIndex(0L, ItemExtent.Variable(20.0))
    private var projection = FoldProjection(0L, [])
    private var foldRevision = -1L
    private var metricRevision = -1L
    private var width = -2.0
    private var options: CodeEditorOptions? = None
    private var version = -1L
    private var revision = -1L
    private var fontRevision = -1L
    private var previousZones = HashMap<Long, Double>()
    private var previousBefore = HashMap<Long, Double>()
    private var maximumWidth = 0.0
    internal var anchor: ReadingAnchor? = None
    private var cache = ArrayList<ShapedLine>()
    private var gutterStyle: TextStyle = textStyle()

    internal fun lineAtPage(line: Long, dy: Double): Long {
        val y = index.prefix(projection.index(line)) + dy
        val next = index.indexAt(if (y < 0.0) 0.0 else y)
        return projection.line(if (next < index.count) next else index.count - 1L)
    }
    internal fun close() {
        for (entry in cache)
            entry.release();
        cache.clear()
    }

    private fun shape(
        source: String,
        style: TextStyle,
        wrap: Double,
        tab: Long,
        used: ArrayList<ShapedLine>,
        runs: Array<EditorStyleRun> = [],
        suffix: String = "",
        hints: Array<LineInlay> = []
    ): ShapedLine {
        val fonts = ink.scope.defaultFonts
        val controls = ink.editor.options.showControlCharacters
        val hintColor = if (hints.size > 0L) Some(ink.editor.options.gutter) else None
        for (line in used) {
            if (line
                .matches(
                    source,
                    style,
                    wrap,
                    tab,
                    fonts.revision,
                    runs,
                    suffix,
                    hints,
                    hintColor,
                    controls
                )
            )
                return line.retain()
        }
        for (line in cache) {
            if (line
                .matches(
                    source,
                    style,
                    wrap,
                    tab,
                    fonts.revision,
                    runs,
                    suffix,
                    hints,
                    hintColor,
                    controls
                )
            ) {
                used.add(line.retain())
                return line.retain()
            }
        }
        val projection = LineProjection.from(source, tab, suffix, hints, controls)
        val paragraph = if (runs.size == 0L && hints.size == 0L)
            Paragraph(fonts, projection.text, style)
        else
            Paragraph(fonts, styledLine(projection, style, runs, ink.editor.options.gutter))
        val layout = paragraph
            .use { paragraph ->
                if (wrap < 0.0) paragraph.layoutUnwrapped() else paragraph.layout(wrap)
            }
        val line = ShapedLine(
            source,
            projection,
            layout,
            style,
            wrap,
            tab,
            fonts.revision,
            runs,
            suffix, hints, hintColor, controls
        )
        used.add(line.retain())
        return line
    }

    private fun shapeSource(
        doc: CodeSnapshot,
        r: Utf8Range,
        line: Long,
        opt: CodeEditorOptions,
        wrap: Double,
        used: ArrayList<ShapedLine>
    ): ShapedLine {
        val styles = ink.decorationsFor(r)
        return shape(
            doc.read(r),
            opt.text,
            wrap,
            opt.tabSize,
            used,
            textStyleRuns(r, styles),
            suffix(line),
            lineInlays(r, styles)
        )
    }

    private fun suffix(line: Long): String = if (projection.endOfFold(line) != None) "  …" else ""

    private fun layoutScroll(
        size: Size,
        gutter: Double,
        pinned: ViewportCaret?,
        screenY: Double,
        reveal: ViewportCaret?
    ): ScrollLayout {
        val state = ink.editor
        val scroll = state.scroll
        var x = scroll.offset.x
        var y = if (pinned != None) pinned!!.top(index) - screenY else scroll.offset.y
        when (reveal) {
            case Some(val caret) -> {
                val top = caret.top(index)
                val bottom = top + caret.height
                if (state.centerReveal)
                    y = (top + bottom - size.height) / 2.0
                else if (top < y)
                    y = top
                else if (bottom > y + size.height) y = bottom - size.height
                if (caret.x < x)
                    x = caret.x
                else if (caret.x > x + size.width - gutter - 4.0)
                    x = caret.x - size.width + gutter + 4.0
            }

            case None -> {}
        }
        val adjustment = if (pinned == None && reveal == None)
            None
        else
            Some(
                ScrollAdjustment(
                    scroll.requestRevision,
                    Point(if (x > 0.0) x else 0.0, if (y > 0.0) y else 0.0)
                )
            )
        return ink
            .bars
            .layout(
                size,
                Size(if (state.options.softWrap) size.width else maximumWidth, index.total),
                adjustment
            )
    }

    internal fun <T> withDetachedLine(line: Long, frame: EditorFrame, run: (ScreenRow) -> T): T {
        val r = frame.document.lineRange(line)
        val used = ArrayList<ShapedLine>()
        val wrap = if (frame.options.softWrap)
            positive(frame.size.width - frame.gutter - 4.0)
        else
            -1.0
        val body = shapeSource(frame.document, r, line, frame.options, wrap, used)
        try {
            return run(ScreenRow(line, r, body, None, 0.0, body.layout.size.height))
        } finally {
            body.release();
            for (item in used)
                item.release()
        }
    }

    internal fun measure(context: MeasureContext, constraints: Constraints): EditorFrame {
        val state = ink.editor
        val opt = state.options
        val doc = ink.input.preview ?: CodeSnapshot(state.document.root, state.document.version)
        val size = constraints
            .constrain(Size(constraints.maxWidth ?: 640.0, constraints.maxHeight ?: 360.0))
        val folds = state.folding.projection(ink.input.preview, ink.input.previewMap)
        val gutter = (
            if (opt.lineNumbers)
                16.0 + doc.lineCount.toString().byteLength.toDouble() * opt.text.fontSize * 0.75
            else
                4.0
        ) +
            (if (opt.foldingControls) 14.0 else 0.0) +
            (if (opt.glyphMargin) 14.0 else 0.0)
        val wrap = if (opt.softWrap) positive(size.width - gutter - 4.0) else -1.0
        val widgets = WidgetLayout(ink, context, size, gutter, doc, folds)
        val estimate = positive(opt.text.fontSize * 1.45)
        val styleChanged = when (options) {
            case Some(val previous) -> previous !== opt;
            case None -> true
        }
        val fonts = ink.scope.defaultFonts
        val previousFrame = ink.accepted
        if (anchor?.request ==
            None &&
            state.reveal ==
            None &&
            !ink.input.composing &&
            state.scroll.offset.y >
            0.0 &&
            previousFrame?.document?.version ==
            Some(doc.version) &&
            previousFrame!!.scrollRevision ==
            state.scroll.requestRevision &&
            (
                !sameZoneHeights(previousZones, widgets.zones) ||
                    !sameZoneHeights(previousBefore, widgets.before) ||
                    metricRevision !=
                    ink.metricRevision ||
                    foldRevision !=
                    state.folding.revision ||
                    width !=
                    wrap ||
                    styleChanged ||
                    fontRevision !=
                    fonts.revision ||
                    previousFrame!!.widgets !==
                    ink.contents.widgets
            )
        ) {
            anchor = previousFrame!!.readingAnchor(state.scroll.requestRevision)
        }
        if (styleChanged) gutterStyle = opt.text.copy { color = opt.gutter }
        projection = folds
        if (metricRevision !=
            ink.metricRevision ||
            foldRevision !=
            state.folding.revision ||
            folds.count !=
            index.count ||
            doc.version !=
            version ||
            (ink.input.composing && revision != ink.input.state.revision) ||
            wrap !=
            width ||
            styleChanged ||
            fonts.revision !=
            fontRevision ||
            ink.projectionChanged
        ) {
            previousZones.clear()
            index = ItemExtentIndex(folds.count, ItemExtent.Variable(estimate))
            maximumWidth = 0.0
            val old = ink.accepted
            if (metricRevision ==
                ink.metricRevision &&
                !styleChanged &&
                wrap ==
                width &&
                fonts.revision ==
                fontRevision &&
                old?.document?.version ==
                Some(doc.version)
            ) {
                for (row in old!!.rows) {
                    if (row.line <
                        doc.lineCount &&
                        !folds.hidden(row.line) &&
                        row.ink.suffix ==
                        suffix(row.line) &&
                        doc.read(doc.lineRange(row.line)) ==
                        row.ink.source
                    )
                        index.record(folds.index(row.line), row.height)
                }
            }
        }
        for (entry in previousZones) {
            val line = entry.key
            val i = folds.index(line)
            if (i < index.count && !folds.hidden(line))
                index.record(i, positive(index.extent(i) - entry.value))
        }
        for (entry in widgets.zones) {
            val i = folds.index(entry.key)
            index.record(i, index.extent(i) + entry.value)
        }
        foldRevision = state.folding.revision
        metricRevision = ink.metricRevision
        previousZones = widgets.zones
        previousBefore = widgets.before
        version = doc.version
        revision = ink.input.state.revision
        options = Some(opt)
        fontRevision = fonts.revision
        width = wrap
        ink.projectionChanged = false
        val scroll = state.scroll
        val used = ArrayList<ShapedLine>()
        val measured = HashMap<Long, ShapedLine>()
        val rows = ArrayList<ScreenRow>()
        fun measureBody(visual: Long): ShapedLine {
            when (val cached = measured[visual]) {
                case Some(val body) -> return body
                case None -> {}
            }
            val line = folds.line(visual)
            val body = shapeSource(doc, doc.lineRange(line), line, opt, wrap, used)
            measured.put(visual, body)
            index.record(visual, positive(body.layout.size.height) + (widgets.zones[line] ?: 0.0))
            val lineWidth = body.layout.size.width + gutter + 4.0
            if (lineWidth > maximumWidth) maximumWidth = lineWidth
            return body
        }
        fun locate(original: Long, affinity: TextAffinity): ViewportCaret {
            val offset = ink.input.previewMap?.map(original) ?: original
            val visual = folds.index(doc.positionAt(offset).line)
            val line = folds.line(visual)
            val r = doc.lineRange(line)
            val body = measureBody(visual)
            val local = if (offset > r.end) r.end - r.start else offset - r.start
            val caret = body.layout.caret(body.display(local, affinity))
            return ViewportCaret(
                visual, caret?.x ?: 0.0,
                (widgets.before[line] ?: 0.0) + (caret?.y ?: 0.0),
                caret?.height ?: positive(body.layout.size.height)
            )
        }
        try {
            val held = anchor
            val pending = state.reveal
            val pinned = if (held?.request ==
                Some(scroll.requestRevision) &&
                (pending == None || !state.centerReveal)
            )
                Some(locate(held!!.offset, held!!.affinity))
            else
                None
            val target = when (pending) {
                case Some(val range) -> Some(locate(range.end, TextAffinity.Downstream))
                case None -> None
            }
            val viewport = measureViewportRows(
                index, size.height, estimate,
                { visual ->
                    measureBody(visual);
                    Unit
                },
                { layoutScroll(size, gutter, pinned, held?.screenY ?: 0.0, target) }
            )
            for (visual in viewport.first..<viewport.end) {
                val line = folds.line(visual)
                val r = doc.lineRange(line)
                val body = measured[visual]!!
                val label = if (opt.lineNumbers)
                    Some(shape((line + 1L).toString(), gutterStyle, -1.0, 1L, used))
                else
                    None
                val original = ink.input.reverseMap?.map(r.start) ?: r.start
                val header = opt.foldingControls &&
                    state.folding.header(state.document.positionAt(original).line)
                rows
                    .add(
                        ScreenRow(
                            line, r, body.retain(), label, index.prefix(visual) +
                                (widgets.before[line] ?: 0.0),
                            positive(body.layout.size.height), header
                        )
                    )
            }
            var spaceWidth = 0.0
            if (opt.rulers.size > 0L) {
                val space = shape(" ", opt.text, -1.0, opt.tabSize, used)
                try {
                    spaceWidth = positive(
                        space.layout.caret(TextPosition(1L))?.x ?: space.layout.size.width
                    )
                } finally {
                    space.release()
                }
            }
            val frame = EditorFrame(
                doc,
                revision,
                opt,
                viewport.scroll,
                size,
                gutter,
                rows.toArray(),
                ink.input.previewMap,
                ink.input.reverseMap, ink.decorationRevision, ink.contents.widgets, scroll
                    .requestRevision, folds, state.folding.revision, spaceWidth
            )
            widgets.place(frame, index)
            return frame
        } catch (error: Throwable) {
            for (row in rows) {
                row.ink.release();
                row.label?.release()
            }
            throw error
        } finally {
            for (entry in measured)
                entry.value.release()
            close()
            cache = used
        }
    }
}

private fun sameZoneHeights(a: HashMap<Long, Double>, b: HashMap<Long, Double>): Boolean {
    if (a.size != b.size) return false
    for (item in a)
        if (b[item.key] != Some(item.value)) return false
    return true
}
