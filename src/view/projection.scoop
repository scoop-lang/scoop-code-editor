package scoop.ui.editor

import scoop.graphics.text.*
import scoop.window.*
import scoop.charset.graphemeBoundaries
import scoop.text.indexOf
import scoop.charset.unicodeScalarWidth

internal fun scalarBytes(ch: Char): Long {
    val cp = ch.code
    return if (cp < 128) 1L else if (cp < 2048) 2L else if (cp < 65536) 3L else 4L
}

internal fun graphemeOffsets(text: String): Array<Long> {
    val scalars = graphemeBoundaries(text)
    val result = ArrayList<Long>()
    var next = 0L
    var scalar = 0L
    var bytes = 0L
    for (ch in text) {
        if (scalar == scalars[next]) {
            result.add(bytes);
            next += 1L
        }
        bytes += scalarBytes(ch)
        scalar += 1L
    }
    result.add(bytes)
    return result.toArray()
}

private struct ProjectionRun(
    val source: Long,
    val sourceLength: Long,
    val display: Long,
    val displayLength: Long
)

internal class LineProjection private constructor(
    internal val text: String,
    private val substitutions: Array<ProjectionRun>,
    internal val sourceEnd: Long,
    private val bytes: Long,
    internal val hints: Array<DisplayInlay> = []
) {
    internal val hasSubstitutions: Boolean get() = substitutions.size > 0L
    private fun expandedOffset(source: Long): Long {
        var low = 0L
        var high = substitutions.size
        while (low < high) {
            val mid = (low + high) / 2L
            if (substitutions[mid].source < source) low = mid + 1L else high = mid
        }
        if (low == 0L) return source
        val run = substitutions[low - 1L]
        return source + run.display + run.displayLength - run.source - run.sourceLength
    }

    private fun expandedSource(display: Long): Long {
        var low = 0L
        var high = substitutions.size
        while (low < high) {
            val mid = (low + high) / 2L
            if (substitutions[mid].display < display) low = mid + 1L else high = mid
        }
        if (low == 0L) return display
        val run = substitutions[low - 1L]
        val distance = display - run.display
        if (distance < run.displayLength)
            return run.source + if (distance * 2L < run.displayLength) 0L else run.sourceLength
        return run.source + run.sourceLength + distance - run.displayLength
    }

    internal fun displayOffset(
        source: Long,
        affinity: TextAffinity = TextAffinity.Downstream
    ): Long {
        val base = expandedOffset(source)
        var low = 0L
        var high = hints.size
        while (low < high) {
            val mid = (low + high) / 2L
            val offset = hints[mid].hint.offset
            if (offset < source || offset == source && affinity == TextAffinity.Downstream)
                low = mid + 1L
            else
                high = mid
        }
        if (low == 0L) return base
        val last = hints[low - 1L]
        return base + last.end - last.base
    }
    private fun hintIndex(display: Long): Long {
        var low = 0L
        var high = hints.size
        while (low < high) {
            val mid = (low + high) / 2L
            if (hints[mid].start <= display) low = mid + 1L else high = mid
        }
        return low - 1L
    }
    internal fun sourceOffset(display: Long): Long {
        if (display >= sourceEnd) return bytes
        val i = hintIndex(display)
        if (i < 0L) return expandedSource(display)
        val last = hints[i]
        return if (display <= last.end)
            last.hint.offset
        else
            expandedSource(display - last.end + last.base)
    }
    internal fun hasInlay(offset: Long): Boolean = hints.size >
        0L &&
        displayOffset(offset, TextAffinity.Upstream) !=
        displayOffset(offset)
    internal fun sourcePosition(pos: TextPosition): TextPosition {
        val source = sourceOffset(pos.byteOffset)
        val i = hintIndex(pos.byteOffset)
        if (i < 0L || pos.byteOffset > hints[i].end) return TextPosition(source, pos.affinity)
        val a = displayOffset(source, TextAffinity.Upstream)
        val b = displayOffset(source)
        return TextPosition(
            source,
            if (pos.byteOffset - a < b - pos.byteOffset)
                TextAffinity.Upstream
            else
                TextAffinity.Downstream
        )
    }
    internal fun movedPosition(previous: TextPosition, next: TextPosition): TextPosition {
        val mapped = sourcePosition(next)
        val i = hintIndex(next.byteOffset)
        if (i < 0L || next.byteOffset >= hints[i].end) return mapped
        val a = displayOffset(mapped.byteOffset, TextAffinity.Upstream)
        val b = displayOffset(mapped.byteOffset)
        if (previous.byteOffset != a && previous.byteOffset != b) return mapped
        return TextPosition(
            mapped.byteOffset,
            if (next.byteOffset > previous.byteOffset)
                TextAffinity.Downstream
            else
                TextAffinity.Upstream
        )
    }
    internal fun sourceSpans(start: Long, end: Long, emit: (Long, Long) -> Unit) {
        var at = displayOffset(start)
        val stop = displayOffset(end, TextAffinity.Upstream)
        var i = hintIndex(at) + 1L
        while (i < hints.size && hints[i].start < stop) {
            val hint = hints[i]
            if (at < hint.start) emit(at, hint.start)
            at = hint.end
            i += 1L
        }
        if (at < stop) emit(at, stop)
    }
    internal companion object {
        internal fun from(
            text: String,
            tabSize: Long,
            suffix: String = "",
            inlays: Array<LineInlay> = [],
            controls: Boolean = false
        ): LineProjection {
            val base = expandCharacters(text, tabSize, suffix, controls)
            if (inlays.size == 0L) return base
            val shown = StringBuilder()
            val runs = ArrayList<DisplayInlay>()
            var at = 0L
            var extra = 0L
            for (hint in inlays) {
                val mark = base.expandedOffset(hint.offset)
                if (mark > at) shown.append(base.text.utf8Slice(Utf8Range(at, mark)))
                shown.append(hint.text.label)
                val start = mark + extra
                extra += hint.text.label.byteLength
                runs.add(DisplayInlay(hint, mark, start, mark + extra))
                at = mark
            }
            if (at < base.text.byteLength)
                shown.append(base.text.utf8Slice(Utf8Range(at, base.text.byteLength)))
            return LineProjection(
                shown.toString(),
                base.substitutions,
                base.sourceEnd + extra,
                text.byteLength,
                runs.toArray()
            )
        }
        private fun expandCharacters(
            text: String,
            tabSize: Long,
            suffix: String,
            controls: Boolean
        ): LineProjection {
            if (tabSize <= 0L) throw IllegalArgumentException(Some("tab size must be positive"))
            var changed = text.indexOf("\t") >= 0L
            if (controls && !changed)
                for (ch in text)
                    if (controlLabel(ch) != None) {
                        changed = true;
                        break
                    }
            if (!changed)
                return LineProjection(
                    if (suffix.byteLength == 0L) text else text + suffix,
                    [],
                    text.byteLength, text.byteLength
                )
            val boundaries = graphemeBoundaries(text)
            val output = StringBuilder()
            val substitutions = ArrayList<ProjectionRun>()
            var scalar = 0L
            var cluster = 0L
            var column = 0L
            var width = 0L
            var source = 0L
            var display = 0L
            for (ch in text) {
                if (scalar == boundaries[cluster]) {
                    column += width
                    width = 1L
                    cluster += 1L
                }
                if (ch == '\t') {
                    width = tabSize - column % tabSize
                    substitutions.add(ProjectionRun(source, 1L, display, width))
                    for (i in 0L..<width)
                        output.append(" ")
                    display += width
                } else {
                    val visual = if (controls) controlLabel(ch) else None
                    when (visual) {
                        case Some(val label) -> {
                            substitutions
                                .add(
                                    ProjectionRun(
                                        source,
                                        scalarBytes(ch),
                                        display,
                                        label.byteLength
                                    )
                                )
                            output.append(label)
                            display += label.byteLength
                        }

                        case None -> {
                            val cells = unicodeScalarWidth(ch).toLong()
                            if (cells > width) width = cells
                            output.append(ch)
                            display += scalarBytes(ch)
                        }
                    }
                }
                source += scalarBytes(ch)
                scalar += 1L
            }
            output.append(suffix)
            return LineProjection(
                output.toString(),
                substitutions.toArray(),
                display,
                text.byteLength
            )
        }
    }
}
