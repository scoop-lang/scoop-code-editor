package scoop.ui.editor

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.component.ScrollbarVisibility

public class CodeEditorOptions public constructor(
    public val theme: CodeEditorTheme = lightCodeTheme(),
    public val softWrap: Boolean = false,
    public val tabSize: Long = 4L,
    public val lineNumbers: Boolean = true,
    public val text: TextStyle = textStyle {
        families = ["Menlo", "monospace"];
        fontSize = 14.0;
        color = theme.foreground
    },
    public val background: Color = theme.background,
    public val gutter: Color = theme.gutter,
    public val selection: Color = theme.selection,
    public val caret: Color = theme.caret,
    public val insertSpaces: Boolean = false,
    public val indentSize: Long = tabSize,
    public val multiCursorPaste: CodeMultiCursorPaste = CodeMultiCursorPaste.Spread,
    public val scrollbars: ScrollbarVisibility = ScrollbarVisibility.Auto,
    public val highlightCurrentLine: Boolean = true,
    public val highlightSelectionMatches: Boolean = true,
    public val highlightBrackets: Boolean = true,
    public val indentGuides: Boolean = false,
    public val whitespace: CodeWhitespace = CodeWhitespace.None,
    public val showControlCharacters: Boolean = false,
    public val rulers: Array<Long> = [],
    public val glyphMargin: Boolean = true,
    public val foldingControls: Boolean = true
) {
    init {
        for (column in rulers)
            if (column <= 0L) throw IllegalArgumentException(Some("ruler column must be positive"))
        if (tabSize <= 0L || indentSize <= 0L)
            throw IllegalArgumentException(Some("tab and indent sizes must be positive"))
    }
}
