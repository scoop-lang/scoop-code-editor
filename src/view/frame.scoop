package scoop.ui.editor

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.window.Utf8Range

internal class ShapedLine(
    val source: String,
    val projection: LineProjection,
    val layout: TextLayout,
    val style: TextStyle,
    val width: Double,
    val tabSize: Long,
    val fontsRevision: Long,
    val runs: Array<ColorRun> = [],
    val suffix: String = ""
) {
    private var owners = 1L
    internal fun display(
        source: Long,
        affinity: TextAffinity = TextAffinity.Downstream
    ): TextPosition {
        val offset = projection.displayOffset(source)
        val boundaries = layout.graphemeBoundaries
        var low = 0L
        var high = boundaries.size - 1L
        while (low < high) {
            val mid = (low + high) / 2L
            if (boundaries[mid] < offset) low = mid + 1L else high = mid
        }
        val index = if (boundaries[low] != offset && low > 0L && affinity == TextAffinity.Upstream)
            low - 1L
        else
            low
        return TextPosition(boundaries[index], affinity)
    }
    internal fun matches(
        text: String,
        textStyle: TextStyle,
        wrap: Double,
        tab: Long,
        fontRevision: Long,
        colors: Array<ColorRun>,
        ending: String
    ): Boolean = source ==
        text &&
        style ===
        textStyle &&
        width ==
        wrap &&
        tabSize ==
        tab &&
        fontsRevision ==
        fontRevision &&
        suffix ==
        ending &&
        sameRuns(runs, colors)

    internal fun retain(): ShapedLine {
        owners += 1L;
        return this
    }
    internal fun release() {
        owners -= 1L;
        if (owners == 0L) layout.close()
    }
}

internal class ScreenRow(
    val line: Long,
    val range: Utf8Range,
    val ink: ShapedLine,
    val label: ShapedLine?,
    val top: Double,
    val height: Double,
    val foldHeader: Boolean = false
) {
    internal fun display(position: TextPosition): TextPosition = ink
        .display(position.byteOffset - range.start, position.affinity)
    internal fun source(position: TextPosition): TextPosition = TextPosition(
        range.start + ink.projection.sourceOffset(position.byteOffset),
        position.affinity
    )
}

internal class EditorFrame(
    val document: CodeSnapshot,
    val inputRevision: Long,
    val options: CodeEditorOptions,
    val scroll: ScrollLayout,
    val size: Size,
    val gutter: Double,
    val rows: Array<ScreenRow>,
    val projected: CodeEditMap?,
    val unprojected: CodeEditMap?,
    val decorationRevision: Long,
    val widgets: Array<EditorWidget>,
    val scrollRevision: ULong,
    val folds: FoldProjection,
    val foldRevision: Long
) {
    private var owners = 1L
    internal val origin: Point get() = scroll.presentationOffset
    internal fun retain(): EditorFrame {
        owners += 1L;
        return this
    }
    internal fun release() {
        owners -= 1L
        if (owners == 0L)
            for (row in rows) {
                row.ink.release();
                row.label?.release()
            }
    }
    internal fun displayPosition(pos: TextPosition): TextPosition = TextPosition(
        projected?.map(pos.byteOffset) ?: pos.byteOffset,
        pos.affinity
    )
    internal fun original(pos: TextPosition): TextPosition = TextPosition(
        unprojected?.map(pos.byteOffset) ?: pos.byteOffset,
        pos.affinity
    )

    internal fun rowAt(position: TextPosition): ScreenRow? {
        val line = document.positionAt(position.byteOffset).line
        for (row in rows) {
            if (row.line == line) return Some(row)
        }
        return None
    }

    internal fun displayCaret(position: TextPosition): Rect? {
        val row = rowAt(position) ?: return None
        val offset = if (position.byteOffset > row.range.end)
            TextPosition(row.range.end)
        else
            position
        val rect = row.ink.layout.caret(row.display(offset)) ?: return None
        return Some(
            Rect(gutter + rect.x - origin.x, row.top + rect.y - origin.y, rect.width, rect.height)
        )
    }

    internal fun hit(point: Point): TextPosition? {
        if (rows.size == 0L) return None
        val y = point.y + origin.y
        var row = rows[rows.size - 1L]
        for (candidate in rows) {
            if (y < candidate.top + candidate.height) {
                row = candidate;
                break
            }
        }
        val pos = row.ink.layout.hitTest(Point(point.x - gutter + origin.x, y - row.top))
        return Some(original(row.source(pos)))
    }

    internal fun readingAnchor(request: ULong): ReadingAnchor? {
        val position = hit(Point(gutter + 1.0, 0.0)) ?: return None
        val caret = displayCaret(displayPosition(position)) ?: return None
        return Some(ReadingAnchor(position.byteOffset, caret.y, request, position.affinity))
    }

    internal fun foldTarget(point: Point): Long? {
        val y = point.y + origin.y
        for (row in rows) {
            if (y < row.top || y >= row.top + row.height) continue
            if (row.foldHeader && options.foldingControls && point.x >= 2.0 && point.x < 16.0)
                return Some(row.line)
            val p = row.ink.projection
            if (p.sourceEnd < p.text.byteLength) {
                val local = Point(point.x - gutter + origin.x, y - row.top)
                for (box in row.ink.layout.selection(TextRange(p.sourceEnd, p.text.byteLength))) {
                    val r = box.rect
                    if (local.x >=
                        r.x &&
                        local.x <
                        r.x +
                        r.width &&
                        local.y >=
                        r.y &&
                        local.y <
                        r.y +
                        r.height
                    )
                        return Some(row.line)
                }
            }
            break
        }
        return None
    }

    internal fun visible(): Array<Utf8Range> {
        if (rows.size == 0L || size.height <= 0.0) return []
        val ranges = ArrayList<Utf8Range>()
        var first = -1L
        var previous = -1L
        var end = 0L
        for (row in rows) {
            if (row.top + row.height <= origin.y || row.top >= origin.y + size.height) continue
            for (visual in row.ink.layout.lines) {
                val top = row.top + visual.rect.y
                if (top + visual.rect.height <= origin.y || top >= origin.y + size.height) continue
                val a = row.range.start + row.ink.projection.sourceOffset(visual.range.start)
                if (first >= 0L && row.line > previous + 1L) {
                    ranges
                        .add(
                            Utf8Range(
                                original(TextPosition(first)).byteOffset,
                                original(TextPosition(end)).byteOffset
                            )
                        )
                    first = -1L
                }
                if (first < 0L) first = a
                previous = row.line
                end = row.range.start + row.ink.projection.sourceOffset(visual.range.end)
            }
        }
        if (first >= 0L)
            ranges
                .add(
                    Utf8Range(
                        original(TextPosition(first)).byteOffset,
                        original(TextPosition(end)).byteOffset
                    )
                )
        return ranges.toArray()
    }
}

internal fun equalVisibleRanges(a: Array<Utf8Range>, b: Array<Utf8Range>): Boolean {
    if (a.size != b.size) return false
    for (i in 0L..<a.size)
        if (a[i] != b[i]) return false
    return true
}
