package scoop.ui.editor

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.window.Utf8Range

internal fun paintRange(
    canvas: Canvas,
    frame: EditorFrame,
    row: ScreenRow,
    range: Utf8Range,
    color: Color,
    underline: Boolean
) {
    val start = if (range.start > row.range.start) range.start else row.range.start
    val end = if (range.end < row.range.end) range.end else row.range.end
    val dx = frame.gutter - frame.origin.x
    val dy = row.top - frame.origin.y
    val paint = Paint(color = color)
    if (start < end) {
        row
            .ink
            .projection
            .sourceSpans(start - row.range.start, end - row.range.start) { a, b ->
                for (box in row.ink.layout.selection(TextRange(a, b))) {
                    val r = box.rect
                    canvas
                        .drawRect(
                            if (underline)
                                Rect(dx + r.x, dy + r.y + r.height - 1.0, r.width, 1.0)
                            else
                                Rect(dx + r.x, dy + r.y, r.width, r.height),
                            paint
                        )
                }
            }
    }
    if (!underline && range.start <= row.range.end && range.end > row.range.end) {
        val edge = row.ink.layout.caret(TextPosition(row.ink.projection.text.byteLength))
        when (edge) {
            case Some(val r) ->
                canvas
                    .drawRect(
                        Rect(dx + r.x, dy + r.y, frame.options.text.fontSize * 0.55, r.height),
                        paint
                    );
            case None -> {}
        }
    }
}

internal fun drawEditor(context: SceneContext, frame: EditorFrame, ink: EditorInk) {
    val opt = frame.options
    val size = frame.size
    context
        .draw { paint ->
            val canvas = paint.canvas
            canvas.drawRect(Rect(0.0, 0.0, size.width, size.height), Paint(color = opt.background))
            for (row in frame.rows) {
                val lineStyles = ink.decorationsFor(row.range)
                if (opt.glyphMargin)
                    when (val glyph = lineGlyph(row, lineStyles)) {
                        case Some(val g) -> paintGlyph(canvas, frame, row, g)
                        case None -> {}
                    }
                for (d in lineStyles) {
                    when (d.style.gutter) {
                        case Some(val color) ->
                            canvas
                                .drawRect(
                                    Rect(1.0, row.top - frame.origin.y, 3.0, row.height),
                                    Paint(color = color)
                                );
                        case None -> {}
                    }
                }
                if (row.foldHeader) {
                    val y = row.top - frame.origin.y + (row.ink.layout.lines[0L].rect.height / 2.0)
                    val mark = Paint(color = opt.gutter)
                    if (frame.folds.endOfFold(row.line) != None) {
                        canvas.drawLine(Point(6.0, y - 3.5), Point(10.0, y), mark)
                        canvas.drawLine(Point(10.0, y), Point(6.0, y + 3.5), mark)
                    } else {
                        canvas.drawLine(Point(4.5, y - 2.0), Point(8.0, y + 2.0), mark)
                        canvas.drawLine(Point(8.0, y + 2.0), Point(11.5, y - 2.0), mark)
                    }
                }
                when (row.label) {
                    case Some(val label) ->
                        canvas
                            .drawText(
                                label.layout,
                                Point(
                                    frame.gutter - label.layout.size.width - 6.0,
                                    row.top - frame.origin.y
                                )
                            );
                    case None -> {}
                }
            }
        }
    context
        .withState { body ->
            body
                .clipRect(
                    Rect(
                        frame.gutter,
                        0.0,
                        if (size.width > frame.gutter) size.width - frame.gutter else 0.0,
                        size.height
                    )
                )
            body
                .draw { paint ->
                    val canvas = paint.canvas
                    val primary = ink.editor.selections.primaryIndex
                    val selections = ink.editor.selections.values
                    val brackets = if (opt.highlightBrackets && !ink.input.composing)
                        ink.editor.matchingBrackets()
                    else
                        None
                    for (row in frame.rows) {
                        val decorations = ink.decorationsFor(row.range)
                        for (d in decorations)
                            if (paintsWholeLine(d, row))
                                when (val color = d.style.wholeLine) {
                                    case Some(val c) ->
                                        canvas
                                            .drawRect(
                                                Rect(
                                                    frame.gutter,
                                                    row.top - frame.origin.y,
                                                    positive(size.width - frame.gutter),
                                                    row.height
                                                ),
                                                Paint(color = c)
                                            )
                                    case None -> {}
                                }
                        paintCurrentLine(canvas, frame, row, ink)
                        for (d in decorations) {
                            when (d.style.background) {
                                case Some(val c) ->
                                    paintRange(canvas, frame, row, d.range, c, false);
                                case None -> {}
                            }
                        }
                        paintLineHighlights(canvas, frame, row, ink, brackets)
                        for (i in 0L..<selections.size) {
                            val range = selections[i].range
                            if (ink.input.composing && i == primary) {
                                val selection = ink.input.state.selection.range
                                paintRange(
                                    canvas,
                                    frame,
                                    row,
                                    Utf8Range(
                                        ink.input.start + selection.start,
                                        ink.input.start + selection.end
                                    ),
                                    opt.selection,
                                    false
                                )
                            } else {
                                val a = frame.projected?.map(range.start) ?: range.start
                                val b = frame.projected?.map(range.end) ?: range.end
                                paintRange(
                                    canvas,
                                    frame,
                                    row,
                                    Utf8Range(a, b),
                                    opt.selection,
                                    false
                                )
                            }
                        }
                        paintWhitespace(canvas, frame, row, ink)
                        canvas
                            .drawText(
                                row.ink.layout,
                                Point(frame.gutter - frame.origin.x, row.top - frame.origin.y)
                            )
                        for (d in decorations) {
                            when (d.style.underline) {
                                case Some(val color) ->
                                    paintRange(canvas, frame, row, d.range, color, true);
                                case None -> {}
                            }
                        }
                        when (brackets) {
                            case Some(val pair) -> {
                                paintRange(
                                    canvas,
                                    frame,
                                    row,
                                    pair.current,
                                    opt.theme.bracketEdge,
                                    true
                                )
                                paintRange(
                                    canvas,
                                    frame,
                                    row,
                                    pair.partner,
                                    opt.theme.bracketEdge,
                                    true
                                )
                            }

                            case None -> {}
                        }
                        when (ink.input.state.markedRange) {
                            case Some(val r) ->
                                paintRange(
                                    canvas,
                                    frame,
                                    row,
                                    Utf8Range(ink.input.start + r.start, ink.input.start + r.end),
                                    opt.caret,
                                    true
                                );
                            case None -> {}
                        }
                    }
                    paintRulers(canvas, frame)
                    if (ink.area.isFocusActive && (ink.caretVisible || ink.input.composing)) {
                        for (i in 0L..<selections.size) {
                            val pos = if (i == primary)
                                ink.activePosition(frame)
                            else
                                frame.displayPosition(selections[i].cursor)
                            when (frame.displayCaret(pos)) {
                                case Some(val r) -> canvas.drawRect(r, Paint(color = opt.caret));
                                case None -> {}
                            }
                        }
                    }
                }
        }
}
