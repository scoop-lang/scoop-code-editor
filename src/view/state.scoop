package scoop.ui.editor

import scoop.graphics.Rect
import scoop.graphics.text.TextPosition
import scoop.ui.*
import scoop.window.Utf8Range

public class CodeEditorState public constructor(public val document: CodeDocument) : Closeable {
    internal val identity = EditorIdentity()
    internal val selectionEvents = EditorSignal<CodeSelections>()
    internal var closed = false
    private var current = CodeSelections([CodeSelection.caret(0L)])
    public val selections: CodeSelections get() = current
    public val folding = CodeFolding(this)
    internal val generatedPairs = ArrayList<GeneratedPair>()
    internal val actions = ArrayList<EditorAction>()
    internal val menuRevision = state(0L)
    internal var focusAfterLayout = false
    internal var gotoPanel: Closeable? = None
    internal var pendingReading: ReadingAnchor? = None
    internal var centerReveal = false
    internal var menuStatus = -1
    internal var activeFind: CodeFind? = None
    public val find: CodeFind get() = activeFind ?: CodeFind(this)
    internal val widgets = ArrayList<EditorWidget>()
    internal var widgetId = 0L
    internal val widgetList = state<Array<EditorWidget>>([])
    internal val decorationStore = DecorationStore(document) { update ->
        mounted?.decorationChanged(update)
    }
    public fun decorations(): CodeDecorations = decorationStore.create()
    internal var mounted: EditorInk? = None
    internal var reveal: Utf8Range? = None
    internal val viewportEvents = EditorSignal<Array<Utf8Range>>()
    public val scroll = ScrollState()
    private var settings = CodeEditorOptions()
    private var locked = false
    public var tabMovesFocus: Boolean = false
    public var options: CodeEditorOptions
        get() = settings
        set(value) {
            settings = value;
            mounted?.settingsChanged()
        }
    public var readOnly: Boolean
        get() = locked
        set(value) {
            if (value != locked) {
                locked = value;
                mounted?.settingsChanged()
            }
        }

    public fun onViewportChange(listener: (Array<Utf8Range>) -> Unit): Closeable = viewportEvents
        .listen(listener)
    public fun visibleRanges(): Array<Utf8Range> {
        val ink = mounted ?: return [];
        return ink.currentFrame()?.visible() ?: []
    }
    public fun caretRect(position: TextPosition): Rect? {
        val ink = mounted ?: return None
        val frame = ink.currentFrame() ?: return None
        if (!scalarBoundary(document.root, position.byteOffset)) return None
        val local = ink.clippedCaret(frame, frame.displayPosition(position)) ?: return None
        return ink.area.toWindow(local)
    }
    private fun endIsVisible(range: Utf8Range): Boolean {
        val ink = mounted ?: return false
        val frame = ink.currentFrame() ?: return false
        val r = frame.displayCaret(frame.displayPosition(TextPosition(range.end))) ?: return false
        return r.x >=
            frame.gutter &&
            r.x +
            r.width <=
            frame.size.width -
            4.0 &&
            r.y >=
            0.0 &&
            r.y +
            r.height <=
            frame.size.height
    }
    public fun revealRange(range: Utf8Range, center: Boolean = false) {
        if (!validRange(document.root, range))
            throw IllegalArgumentException(Some("invalid reveal range"))
        folding.reveal(document.positionAt(range.start).line)
        folding.reveal(document.positionAt(range.end).line)
        if (!center && reveal == None && endIsVisible(range)) return
        centerReveal = center
        reveal = Some(range)
        when (mounted) {
            case Some(val ink) -> {
                scroll.beginLayoutRequest();
                ink.scope.requestLayout()
            };

            case None -> {}
        }
    }
    public fun requestFocus(): Boolean = mounted?.focus?.handle?.requestFocus() ?: false
    public val hasFocus: Boolean get() = mounted?.area?.isFocusActive ?: false

    init {
        document.attach(this)
        installNativeActions()
        installLineActions()
        installFindActions()
        installViewActions()
        installCodeActions()
        installFoldActions()
    }

    public fun onSelectionChange(listener: (CodeSelections) -> Unit): Closeable = selectionEvents
        .listen(listener)

    public fun setSelections(values: List<CodeSelection>, primaryIndex: Long = 0L) {
        if (closed || document.busy)
            throw IllegalStateException(Some("editor is closed or delivering an edit"))
        val next = normalizedSelections(document.root, CodeSelections(values, primaryIndex)) ?:
            throw IllegalArgumentException(Some("invalid editor selections"))
        breakUndoGroup()
        if (install(next)) selectionEvents.emit(next)
    }

    internal fun install(next: CodeSelections): Boolean {
        if (sameSelections(current, next)) return false
        current = next
        return true
    }

    public fun executeEdits(
        expectedVersion: Long,
        edits: List<CodeEdit>,
        selectAfter: ((CodeEditMap) -> CodeSelections)? = None,
        kind: CodeEditKind = CodeEditKind.Command
    ): CodeEditResult = document.transact(Some(this), expectedVersion, edits, selectAfter, kind)

    public val canUndo: Boolean get() = !closed && !readOnly && document.history.undo.size > 0L
    public val canRedo: Boolean get() = !closed && !readOnly && document.history.redo.size > 0L
    public fun undo(): CodeEditResult = document.replay(this, false)
    public fun redo(): CodeEditResult = document.replay(this, true)
    public fun breakUndoGroup() {
        document.history.boundary = true
    }

    public override fun close() {
        if (closed) return
        closed = true
        breakUndoGroup()
        document.detach(this)
        mounted?.stateClosed()
        activeFind?.close()
        gotoPanel?.close()
        gotoPanel = None
        actions.clear()
        decorationStore.close()
        widgets.clear()
        widgetList.value = []
        selectionEvents.clear()
        viewportEvents.clear()
    }
}
