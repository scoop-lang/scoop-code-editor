package scoop.ui.editor

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.*
import scoop.ui.*
import scoop.window.*

internal fun EditorInk.publish(value: TextInputState, origin: TextInputOrigin? = None) {
    val active = connection ?: return
    if (ended || retiring || !area.isFocusActive || editor.readOnly) return
    val caret = area.visibleCaretBounds ?: Rect(0.0, 0.0, 0.0, 0.0)
    val rect = LogicalRect(
        LogicalPosition(caret.x, caret.y),
        LogicalSize(caret.width, caret.height)
    )
    scope
        .nativeWindow
        .publishTextInputState(
            active,
            TextInputState(
                value.surroundingText, value.selection,
                value.markedRange, rect, value.revision
            ),
            origin
        )
}

internal fun EditorInk.native(event: TextInputEvent) {
    when (event) {
        case Enabled(val active) -> {
            connection = active;
            retiring = false;
            publish(input.state)
        }

        case Disabled(val old) -> {
            if (connection != None && old != connection) return
            connection = None
            retiring = false
            if (input.composing) {
                input.synchronize(true);
                projectionChanged = true;
                scope.requestLayout()
            }
        }

        case Edit(val batch) -> {
            if (retiring ||
                connection ==
                None ||
                !area.isFocusActive ||
                editor.readOnly ||
                (batch.origin != None && Some(batch.origin!!.connection) != connection)
            )
                return
            val composed = input.composing
            val reply = input.accept(batch)
            when (reply) {
                case Some(val applied) -> {
                    publish(applied.acknowledgement, batch.origin)
                    when (applied.context) {
                        case Some(val next) -> publish(next);
                        case None -> {}
                    }
                    projectionChanged = composed || input.composing
                    preferredX = []
                    caretVisible = true
                    blinkReset()
                    if (!input.composing) editor.revealRange(editor.selections.primary.range)
                    scope.requestLayout()
                }

                case None -> {
                    input.synchronize(true);
                    projectionChanged = true;
                    retiring = area.restartTextInput();
                    scope.requestLayout()
                }
            }
        }
    }
}

internal fun EditorInk.event(context: RoutedEventContext, event: InputEvent) {
    if (ended || !scope.isMounted) return
    if (context.phase == RoutedPhase.Notification) {
        when (event) {
            case FocusChanged(val active) -> {
                editor.breakUndoGroup()
                dragging = false
                if (!active && input.composing) {
                    input.synchronize(true);
                    projectionChanged = true;
                    scope.requestLayout()
                }
                if (active) {
                    refreshInput();
                    publish(input.state)
                }
                caretVisible = true
                blinkReset()
                scope.requestFrame()
            }

            case TextInput(val value) -> native(value)
            case Pointer(InputPointerEvent.Cancelled(_, _)) -> dragging = false
            else -> {}
        }
        return
    }
    if (context.phase != RoutedPhase.Default) return
    when (event) {
        case Pointer(
            InputPointerEvent.Button(val pointer, MouseButton.Left, val button, val count)
        ) -> {
            if (button == ElementState.Pressed) {
                val point = context.localPosition ?: return
                val frame = currentFrame() ?: return
                val hit = frame.hit(point) ?: return
                area.requestFocus(FocusOrigin.Pointer)
                val before = editor.selections
                if (count >= 3 || point.x < frame.gutter) {
                    val r = editor
                        .document
                        .lineRange(editor.document.positionAt(hit.byteOffset).line, true)
                    editor.setSelections([CodeSelection.offsets(r.start, r.end)])
                } else if (count == 2) {
                    val pos = frame.displayPosition(hit)
                    val row = frame.rowAt(pos) ?: return
                    val word = row.ink.layout.wordRange(row.display(pos))
                    editor
                        .setSelections(
                            [
                                CodeSelection(
                                    frame.original(row.source(TextPosition(word.start))),
                                    frame.original(row.source(TextPosition(word.end)))
                                )
                            ]
                        )
                } else if (pointer.state.modifiers.alt) {
                    val added = ArrayList<CodeSelection>()
                    for (s in before.values)
                        added.add(s)
                    added.add(CodeSelection(hit, hit))
                    editor.setSelections(added, added.size - 1L)
                } else
                    editor
                        .setSelections(
                            [
                                CodeSelection(
                                    if (pointer.state.modifiers.shift)
                                        before.primary.anchor
                                    else
                                        hit,
                                    hit
                                )
                            ]
                        )
                preferredX = []
                dragging = true
            } else
                dragging = false
            context.consume()
        }

        case Pointer(InputPointerEvent.Moved(_)) ->
            if (dragging) {
                val pos = context.localPosition ?: return
                val frame = currentFrame() ?: return
                val hit = frame.hit(pos) ?: return
                val old = editor.selections
                editor
                    .setSelections(
                        Array<CodeSelection>(old.values.size) { i ->
                            if (i == old.primaryIndex)
                                CodeSelection(old.primary.anchor, hit)
                            else
                                old.values[i]
                        },
                        old.primaryIndex
                    )
                context.consume()
            }
        case Pointer(InputPointerEvent.Wheel(_, _, val phase, val momentum)) ->
            viewport
                .consumeScroll(
                    context, editor.options.text.fontSize, if (editor.options.softWrap)
                        ScrollAxes.Vertical
                    else
                        ScrollAxes.Both,
                    phase = phase, momentumPhase = momentum
                )
        case TextCommand(val command) -> if (command(command)) context.consume()

        case Keyboard(val key) -> {
            if (!area.isFocusActive || key.state != ElementState.Pressed || key.synthetic) return
            var handled = false
            for (cmd in key.textCommands) {
                if (command(cmd)) handled = true
            }
            if (handled || (key.textCommands.size == 0L && fallbackKey(key))) context.consume()
        }

        else -> {}
    }
}

private fun EditorInk.fallbackKey(key: KeyEvent): Boolean {
    val mods = key.modifiers
    if (mods.control || mods.superKey || mods.alt) return false
    val cmd = when (key.physicalKey) {
        case PhysicalKey.Code(KeyCode.ArrowLeft) ->
            TextEditCommand.Move(TextMovement.Left, mods.shift)
        case PhysicalKey.Code(KeyCode.ArrowRight) ->
            TextEditCommand.Move(TextMovement.Right, mods.shift)
        case PhysicalKey.Code(KeyCode.ArrowUp) -> TextEditCommand.Move(TextMovement.Up, mods.shift)
        case PhysicalKey.Code(KeyCode.ArrowDown) ->
            TextEditCommand.Move(TextMovement.Down, mods.shift)
        case PhysicalKey.Code(KeyCode.Backspace) -> TextEditCommand.Delete(TextDeletion.Backward)
        case PhysicalKey.Code(KeyCode.Delete) -> TextEditCommand.Delete(TextDeletion.Forward)
        case PhysicalKey.Code(KeyCode.Enter) -> TextEditCommand.InsertNewline
        case PhysicalKey.Code(KeyCode.Tab) ->
            if (mods.shift) TextEditCommand.InsertBacktab else TextEditCommand.InsertTab
        case PhysicalKey.Code(KeyCode.Home) ->
            TextEditCommand.Move(TextMovement.LineStart, mods.shift)
        case PhysicalKey.Code(KeyCode.End) -> TextEditCommand.Move(TextMovement.LineEnd, mods.shift)
        else -> return false
    }
    return command(cmd)
}
