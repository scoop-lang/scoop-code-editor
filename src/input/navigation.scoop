package scoop.ui.editor

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.window.*

internal fun <T> EditorInk.withLine(
    line: Long,
    frame: EditorFrame,
    run: (ScreenRow) -> T
): T {
    for (row in frame.rows) {
        if (row.line == line) return run(row)
    }
    return layoutEngine.withDetachedLine(line, frame, run)
}

private fun EditorInk.moveInLayout(
    cursor: TextPosition,
    move: TextMovement,
    preferred: Double?,
    frame: EditorFrame
): TextPosition {
    val doc = editor.document
    val logical = doc.positionAt(cursor.byteOffset)
    val forward = move ==
        TextMovement.Forward ||
        move ==
        TextMovement.Right ||
        move ==
        TextMovement.WordForward ||
        move ==
        TextMovement.WordRight
    if (move == TextMovement.Backward || move == TextMovement.Forward)
        return editor.stepGrapheme(cursor, move == TextMovement.Forward)
    when (move) {
        case DocumentStart -> return TextPosition(0L)
        case DocumentEnd -> return TextPosition(doc.byteLength)
        case ParagraphStart -> return TextPosition(doc.lineRange(logical.line).start)
        case ParagraphEnd -> return TextPosition(doc.lineRange(logical.line).end)
        else -> {}
    }
    val words = doc.language?.wordPattern
    if (words != None && (move == TextMovement.WordBackward || move == TextMovement.WordForward)) {
        return TextPosition(doc.languageWordEdge(cursor.byteOffset, forward, words!!))
    }
    return withLine(logical.line, frame) { row ->
        val at = if (cursor.byteOffset > row.range.end)
            TextPosition(row.range.end, cursor.affinity)
        else
            cursor
        val pos = row.display(at)
        val layout = row.ink.layout
        if (move == TextMovement.LineStart) {
            val edge = layout.moveCaret(pos, CaretMovement.LineStart)?.position ?: pos
            val start = row.source(edge)
            if (start.byteOffset == row.range.start) {
                val nonBlank = doc.indentRange(logical.line).end
                val first = layout.lines[0L]
                if (nonBlank !=
                    cursor.byteOffset &&
                    nonBlank <
                    row.range.end &&
                    row.display(TextPosition(nonBlank)).byteOffset <=
                    first.contentRange.end
                )
                    return@withLine TextPosition(nonBlank)
            }
            return@withLine start
        }
        val action = when (move) {
            case Left -> CaretMovement.Left;
            case Right -> CaretMovement.Right
            case WordLeft -> CaretMovement.WordLeft;
            case WordRight -> CaretMovement.WordRight
            case LineStart -> CaretMovement.LineStart;
            case LineEnd -> CaretMovement.LineEnd
            case LineLeft -> CaretMovement.LineLeft;
            case LineRight -> CaretMovement.LineRight
            case Up -> CaretMovement.Up;
            case Down -> CaretMovement.Down
            else -> CaretMovement.DocumentStart
        }
        if (move == TextMovement.WordBackward || move == TextMovement.WordForward) {
            val b = layout.moveWord(pos.byteOffset, forward)
            if (b != pos.byteOffset) return@withLine row.source(TextPosition(b))
        } else if (move == TextMovement.PageUp || move == TextMovement.PageDown) {
            val dy = if (move == TextMovement.PageUp) -frame.size.height else frame.size.height
            val targetY = layoutEngine.lineAtPage(logical.line, dy)
            return@withLine withLine(targetY, frame) { next ->
                next.source(next.ink.layout.hitTest(Point(preferred ?: 0.0, 0.0)))
            }
        } else {
            val next = layout.moveCaret(pos, action, preferred)
            if (words !=
                None &&
                (move == TextMovement.WordLeft || move == TextMovement.WordRight) &&
                next !=
                None &&
                next!!.position.byteOffset !=
                pos.byteOffset
            ) {
                return@withLine TextPosition(
                    doc
                        .languageWordEdge(
                            cursor.byteOffset,
                            next!!.position.byteOffset > pos.byteOffset,
                            words!!
                        )
                )
            }
            if ((move == TextMovement.Left || move == TextMovement.Right) &&
                (row.ink.projection.hints.size > 0L || row.ink.projection.hasSubstitutions)
            ) {
                var step = next
                var last = pos
                while (step != None && step!!.position != last) {
                    val to = step!!.position
                    val result = row.moved(pos, to)
                    if (result != cursor) return@withLine result
                    last = to
                    step = layout.moveCaret(last, action, preferred)
                }
            } else if (next != None && next!!.position != pos) {
                val result = row.source(next!!.position)
                if (result.byteOffset != cursor.byteOffset || row.ink.suffix.byteLength == 0L)
                    return@withLine result
            }
            if (move ==
                TextMovement.LineStart ||
                move ==
                TextMovement.LineEnd ||
                move ==
                TextMovement.LineLeft ||
                move ==
                TextMovement.LineRight
            )
                return@withLine cursor
        }
        if (move == TextMovement.Up || move == TextMovement.Down) {
            val target = frame.folds.index(logical.line) + if (move == TextMovement.Up) -1L else 1L
            if (target < 0L || target >= frame.folds.count) return@withLine cursor
            return@withLine withLine(frame.folds.line(target), frame) { next ->
                val y = if (move == TextMovement.Up) next.height - 1.0 else 0.0
                next.source(next.ink.layout.hitTest(Point(preferred ?: 0.0, y)))
            }
        }
        TextPosition(adjacentGrapheme(doc, cursor.byteOffset, forward))
    }
}

internal fun EditorInk.destination(
    cursor: TextPosition,
    move: TextMovement,
    preferred: Double?,
    frame: EditorFrame
): TextPosition {
    val next = moveInLayout(cursor, move, preferred, frame)
    return editor.folding.visibleDestination(cursor, next, frame.folds)
}

internal fun EditorInk.move(motion: TextMovement, extend: Boolean) {
    val frame = currentFrame() ?: return
    val old = editor.selections
    val values = ArrayList<CodeSelection>()
    val columns = ArrayList<Double?>()
    val vertical = motion ==
        TextMovement.Up ||
        motion ==
        TextMovement.Down ||
        motion ==
        TextMovement.PageUp ||
        motion ==
        TextMovement.PageDown
    for (i in 0L..<old.values.size) {
        val s = old.values[i]
        val column = if (!vertical)
            None
        else if (preferredX.size == old.values.size && preferredX[i] != None)
            preferredX[i]
        else
            Some((frame.displayCaret(s.cursor)?.x ?: frame.gutter) - frame.gutter + frame.origin.x)
        val target = if (!extend &&
            s.range.start <
            s.range.end &&
            (motion == TextMovement.Left || motion == TextMovement.Right)
        )
            TextPosition(if (motion == TextMovement.Left) s.range.start else s.range.end)
        else
            destination(s.cursor, motion, column, frame)
        values.add(CodeSelection(if (extend) s.anchor else target, target))
        columns.add(column)
    }
    editor.setSelections(values, old.primaryIndex)
    preferredX = columns.toArray()
}

internal fun EditorInk.command(cmd: TextEditCommand): Boolean = !ended &&
    area.isFocusActive &&
    editor.invokeCommand(cmd)

internal fun EditorInk.cancelComposition() {
    input.synchronize(true)
    retiring = area.restartTextInput()
    projectionChanged = true
    scope.requestLayout()
}

internal fun EditorInk.deleteTo(d: TextDeletion) {
    val motion = when (d) {
        case WordBackward -> TextMovement.WordBackward
        case WordForward -> TextMovement.WordForward
        case LineStart -> TextMovement.LineStart
        case LineEnd -> TextMovement.LineEnd
        case ParagraphStart -> TextMovement.ParagraphStart
        else -> TextMovement.ParagraphEnd
    }
    val frame = currentFrame() ?: return
    val old = editor.selections
    val ranges = Array<CodeSelection>(old.values.size) { i ->
        val s = old.values[i]
        if (s.range.start != s.range.end)
            s
        else
            CodeSelection(s.anchor, destination(s.cursor, motion, None, frame))
    }
    val normalized = normalizedSelections(
        editor.document.root,
        CodeSelections(ranges, old.primaryIndex)
    )!!
    val edits = Array<CodeEdit>(normalized.values.size) { i ->
        CodeEdit(normalized.values[i].range, "")
    }
    editor.executeEdits(editor.document.version, edits)
}
