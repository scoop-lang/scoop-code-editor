package scoop.ui.editor

import scoop.platform.env.environmentVariable
import scoop.platform.fs.*
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.time.Duration
import scoop.ui.*
import scoop.window.*

/** Coordinates a real desktop input service with a separate accessibility client. */
internal class DesktopProtocol(val nativeStep: (Window, Int) -> Int) {
    private val doc = CodeDocument("首\r\nA🙂B\r\n尾")
    val editor = CodeEditorState(doc)
    private val directory = Path.fromOsString(environmentVariable("SCOOP_EDITOR_PROTOCOL_DIR")!!)
    private val end = MonotonicTimeSource.now() + Duration.seconds(65L)
    private var nextFocus = MonotonicTimeSource.now()
    private var window: Window? = None
    private var stage = 0
    private var tick = true
    private var queued = false
    var finished = false
    init {
        editor.setSelections([CodeSelection.caret(doc.lineRange(1L).start + 5L)])
    }
    private fun mark(name: String) {
        directory.resolve(Path.fromString(name)).writeText("ok")
    }
    fun event(host: UiHost, app: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                val w = app
                    .createWindow(
                        windowAttributes {
                            title = "Scoop editor native protocol";
                            size = LogicalSize(450.0, 220.0)
                        }
                    )
                window = Some(w)
                host.attach(w, { scope -> DesktopRoot(editor, scope) })
                w.requestFocus()
                app
                    .setControlFlow(
                        ControlFlow
                            .WaitUntil(MonotonicTimeSource.now() + Duration.milliseconds(25L))
                    )
            }

            case NewEvents(StartCause.Deadline) -> {
                val now = MonotonicTimeSource.now()
                tick = true
                if (now >= end) fail(Some(f"desktop input timed out in stage ${stage}"))
                if (stage == 0 && now >= nextFocus) {
                    window?.requestFocus();
                    editor.requestFocus();
                    nextFocus = now + Duration.milliseconds(250L)
                }
                app.setControlFlow(ControlFlow.WaitUntil(now + Duration.milliseconds(25L)))
            }

            case AboutToWait -> {
                val ink = editor.mounted ?: return
                if (!tick || queued || finished) return
                tick = false
                queued = true
                app
                    .proxy()
                    .post { active ->
                        queued = false
                        val frame = ink.currentFrame() ?: return@post
                        when (stage) {
                            case 0 -> {
                                if (!editor.hasFocus ||
                                    ink.connection ==
                                    None ||
                                    ink.area.visibleCaretBounds ==
                                    None
                                )
                                    return@post
                                assertEquals("A🙂B", ink.input.state.surroundingText)
                                assertEquals(
                                    editor.caretRect(editor.selections.primary.cursor)!!,
                                    ink.area.visibleCaretBounds!!
                                )
                                mark("ready")
                            }

                            case 1 -> {
                                if (!directory.resolve(Path.fromString("start")).exists())
                                    return@post
                                val result = nativeStep(window!!, 1)
                                assertEquals(
                                    0,
                                    result,
                                    Some(f"native input start returned ${result}")
                                )
                            }

                            case 2 -> {
                                if (!ink.input.composing ||
                                    frame.inputRevision !=
                                    ink.input.state.revision
                                )
                                    return@post
                                assertEquals(0L, doc.version)
                                val rect = ink.clippedCaret(frame, ink.activePosition(frame)) ?:
                                    return@post
                                assertEquals(
                                    ink.area.toWindow(rect)!!,
                                    ink.area.visibleCaretBounds!!
                                )
                                mark("preedit")
                                val result = nativeStep(window!!, 2)
                                assertEquals(
                                    0,
                                    result,
                                    Some(f"native composition commit returned ${result}")
                                )
                            }

                            case 3 -> {
                                if (ink.input.composing || doc.version == 0L) return@post
                                assertEquals(
                                    "首\r\nA🙂中B\r\n尾",
                                    doc.read(Utf8Range(0L, doc.byteLength))
                                )
                                assertEquals("A🙂中B", ink.input.state.surroundingText)
                                mark("committed")
                            }

                            case 4 -> {
                                if (editor.selectedText() != "A🙂") return@post
                                mark("selection")
                            }

                            case 5 -> {
                                if (doc.read(Utf8Range(0L, doc.byteLength)) !=
                                    "accessible replacement"
                                )
                                    return@post
                                assertEquals(2L, doc.version)
                                mark("verified")
                                finished = true
                                active.requestExit()
                            }

                            else -> {}
                        }
                        stage += 1
                    }
            }

            else -> {}
        }
    }
}

internal fun runDesktopProtocol(step: (Window, Int) -> Int) {
    val probe = DesktopProtocol(step)
    UiHost(onRootError = { _, e -> throw e }, handler = { h, a, e -> probe.event(h, a, e) })
        .use { h -> Application().run(h) }
    assertTrue(probe.finished)
    probe.editor.close()
}

private class DesktopRoot(val editor: CodeEditorState, scope: ComponentScope) : Component(scope) {
    public override fun render(): View = codeEditor(editor)
}
