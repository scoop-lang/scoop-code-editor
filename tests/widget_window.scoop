package scoop.ui.editor

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.platform.time.MonotonicTimeSource
import scoop.surface.*
import scoop.test.*
import scoop.text.repeat
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.ThemeSource
import scoop.ui.style.macos.macosTheme
import scoop.window.*

@Test
private class EditorWidgetWindowTests {
    @Test(useProcess = true)
    fun wrapDecorationsZonesAndOverlaysUseAcceptedGeometry() {
        val p = WidgetWindowProbe()
        UiHost(
            onRootError = { _, e -> throw e },
            handler = { host, app, e -> p.event(host, app, e) }
        )
            .use { h ->
                context(ThemeSource(macosTheme())) {
                    Application().run(h)
                }
            }
        assertTrue(p.finished)
    }
}

private class WidgetBox(val size: Size) {
    var area: InputArea? = None
    fun view(): View = element({ scope -> WidgetBoxInk(this, scope) })
}

private class WidgetBoxInk(val box: WidgetBox, scope: ComponentScope) : Element<Unit>(scope) {
    private val area = scope.createArea()
    init {
        box.area = Some(area)
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > = LayoutResult(LayoutMetrics(constraints.constrain(box.size)), Unit)
    public override fun scene(context: SceneContext, layout: Unit) {
        context.place(area, Rect(0.0, 0.0, context.size.width, context.size.height))
    }
}

private class WidgetWindowProbe {
    private val doc = CodeDocument(
        "中\té" + "אבג 123 abc ".repeat(10L) + "\nsecond\n" + "rows\n".repeat(99L)
    )
    val editor = CodeEditorState(doc)
    private val inline = WidgetBox(Size(20.0, 12.0))
    private val overlay = WidgetBox(Size(41.0, 16.0))
    private val zone = WidgetBox(Size(60.0, 31.0))
    private var zoneHandle: Closeable? = None
    private var contentHandle: Closeable? = None
    private var overlayHandle: Closeable? = None
    private var window: Window? = None
    private var firstWrap = 0L
    private var panel: CodeFind? = None
    private var initialTop = -1.0
    private var initialOverlay = -1.0
    private var screenAnchor = -1.0
    private var anchor = 0L
    private var stage = 0
    private var queued = false
    var finished = false
    private val end = MonotonicTimeSource.now() + Duration.seconds(18L)

    fun event(host: UiHost, app: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                editor.options = CodeEditorOptions(softWrap = true)
                val style = editor.decorations()
                style
                    .set(
                        [
                            CodeDecoration(
                                Utf8Range(0L, 3L),
                                CodeDecorationStyle(
                                    foreground = Some(Color(0.7, 0.1, 0.2)),
                                    underline = Some(Color.Black)
                                )
                            )
                        ]
                    )
                contentHandle = Some(
                    editor.addContentWidget(doc.lineRange(1L).start, inline.view())
                )
                overlayHandle = Some(
                    editor.addOverlayWidget(CodeEditorCorner.BottomRight, overlay.view())
                )
                zoneHandle = Some(editor.addViewZone(0L, zone.view()))
                val w = app
                    .createWindow(
                        windowAttributes {
                            title = "Code editor widget geometry";
                            size = LogicalSize(340.0, 230.0);
                            visible = false
                        }
                    )
                window = Some(w)
                host.attach(w, { scope -> WidgetWindowRoot(editor, scope) })
                w.setVisible(true)
                w.requestFocus()
                app
                    .setControlFlow(
                        ControlFlow
                            .WaitUntil(MonotonicTimeSource.now() + Duration.milliseconds(25L))
                    )
            }

            case NewEvents(StartCause.Deadline) -> {
                if (MonotonicTimeSource.now() >= end)
                    fail(Some(f"widget geometry wait expired at stage ${stage}"))
                app
                    .setControlFlow(
                        ControlFlow
                            .WaitUntil(MonotonicTimeSource.now() + Duration.milliseconds(25L))
                    )
            }

            case AboutToWait -> {
                if (queued || finished) return
                val ink = editor.mounted ?: return
                val frame = ink.currentFrame() ?: return
                if (frame.document.version != doc.version) return
                if (stage ==
                    1 &&
                    (zone.area?.isClosed != Some(true) || ink.contents.widgets.size != 2L)
                )
                    return
                if (stage == 2 && editor.scroll.offset.y <= 200.0) return
                if (stage ==
                    4 &&
                    (overlay.area?.isClosed != Some(true) || inline.area?.isClosed != Some(true))
                )
                    return
                if (stage == 5 && frame.size.width < 420.0) return
                if (stage == 6 && (ink.contents.widgets.size != 1L || editor.hasFocus)) return
                if (stage == 7 && (ink.contents.widgets.size != 0L || !editor.hasFocus)) return
                queued = true
                app
                    .proxy()
                    .post { active ->
                        queued = false;
                        advance(active)
                    }
            }

            else -> {}
        }
    }

    private fun advance(app: ActiveApplication) {
        val frame = editor.mounted!!.currentFrame() ?: return
        when (stage) {
            case 0 -> {
                firstWrap = frame.rows[0L].ink.layout.lines.size
                assertTrue(firstWrap > 1L)
                assertEquals(1L, frame.rows[0L].ink.runs.size)
                val row = frame.rows[0L]
                assertEquals(
                    row.display(TextPosition(4L, TextAffinity.Upstream)),
                    row.display(TextPosition(5L, TextAffinity.Upstream))
                )
                assertEquals(row.display(TextPosition(7L)), row.display(TextPosition(5L)))
                editor.setSelections([CodeSelection.caret(5L)])
                assertTrue(editor.caretRect(TextPosition(5L)) != None)
                val alef = row
                    .ink
                    .layout
                    .selection(
                        TextRange(
                            row.display(TextPosition(7L)).byteOffset,
                            row.display(TextPosition(9L)).byteOffset
                        )
                    )[0L]
                    .rect
                val bet = row
                    .ink
                    .layout
                    .selection(
                        TextRange(
                            row.display(TextPosition(9L)).byteOffset,
                            row.display(TextPosition(11L)).byteOffset
                        )
                    )[0L]
                    .rect
                assertTrue(alef.x > bet.x)
                val hit = frame
                    .hit(
                        Point(frame.gutter + alef.x + alef.width * 0.8, alef.y + alef.height * 0.5)
                    )!!
                assertEquals(7L, hit.byteOffset)
                val zoneRect = zone.area!!.windowBounds!!
                assertEquals(31.0, zoneRect.height)
                val after = editor.caretRect(TextPosition(doc.lineRange(1L).start))!!
                initialTop = after.y
                assertTrue(after.y >= zoneRect.y + zoneRect.height - 1.0)
                val inlineRect = inline.area!!.windowBounds!!
                assertTrue(inline.area!!.hitTest(Point(inlineRect.x + 1.0, inlineRect.y + 1.0)))
                initialOverlay = overlay.area!!.windowBounds!!.y
                zoneHandle!!.close()
                stage += 1
            }

            case 1 -> {
                val after = editor.caretRect(TextPosition(doc.lineRange(1L).start))!!
                assertTrue(
                    initialTop - after.y >= 30.0,
                    Some(
                        f"zone removal: old ${initialTop}, new ${after.y}, scroll ${
                            frame.origin.y
                        }, row ${frame.rows[1L].top}"
                    )
                )
                editor.revealRange(doc.lineRange(70L))
                stage += 1
            }

            case 2 -> {
                assertEquals(initialOverlay, overlay.area!!.windowBounds!!.y)
                assertEquals(None, inline.area!!.windowBounds)
                anchor = doc.lineRange(70L).start
                screenAnchor = editor.caretRect(TextPosition(anchor))!!.y
                doc.applyEdits(doc.version, [CodeEdit(Utf8Range(0L, 0L), "new\n")])
                stage += 1
            }

            case 3 -> {
                val after = editor.caretRect(TextPosition(anchor + 4L)) ?: return
                assertTrue(
                    after.y >= screenAnchor - 1.0 && after.y <= screenAnchor + 1.0,
                    Some(f"reading anchor: old ${screenAnchor}, new ${after.y}")
                )
                contentHandle!!.close();
                overlayHandle!!.close()
                stage += 1
            }

            case 4 -> {
                editor.revealRange(doc.lineRange(1L))
                window!!.requestSize(LogicalSize(540.0, 230.0))
                stage += 1
            }

            case 5 -> {
                val row = frame.rowAt(TextPosition(doc.lineRange(1L).start)) ?: return
                assertTrue(row.ink.layout.lines.size < firstWrap)
                val selected = CodeFind(editor, "second")
                panel = Some(selected)
                editor.requestFocus()
                assertTrue(editor.runAction("find.open"))
                stage += 1
            }

            case 6 -> {
                assertTrue(editor.runAction("find.next"))
                assertEquals("second", doc.read(editor.selections.primary.range))
                panel!!.closePanel()
                stage += 1
            }

            case 7 -> {
                panel!!.close()
                finished = true;
                app.requestExit()
            }

            else -> {}
        }
    }
}

private class WidgetWindowRoot(val editor: CodeEditorState, scope: ComponentScope) :
    Component(scope) {
    public override fun render(): View = codeEditor(editor)
}
