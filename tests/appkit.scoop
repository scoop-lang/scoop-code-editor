package scoop.ui.editor

import scoop.graphics.text.TextPosition
import scoop.platform.env.environmentVariable
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.time.Duration
import scoop.ui.*
import scoop.window.*
import scoop.window.native.*

@Extern(name = "dlopen")
private fun loadEditorProbe(path: Ptr<Int8>, mode: Int): Ptr<Unit>?

@Extern(name = "dlsym")
private fun editorProbeSymbol(image: Ptr<Unit>, name: Ptr<Int8>): FunPtr<(Ptr<Unit>, Int) -> Int>?

@Extern(name = "dlclose")
private fun closeEditorProbe(image: Ptr<Unit>): Int

@Test
private class AppKitProtocolTests {
    @Test(useProcess = true)
    fun nativeClientSeesLocalTextWhileAccessibilityReadsFullDocument() {
        val path = environmentVariable("SCOOP_EDITOR_APPKIT_PROBE") ?: return
        @Unsafe {
            val image = path
                .decodeUtf8()
                .withCString { p ->
                    @Unsafe {
                        return@withCString loadEditorProbe(p, 2)
                    }
                }!!
            try {
                val function = "scoop_editor_appkit_probe"
                    .withCString { name ->
                        @Unsafe {
                            return@withCString editorProbeSymbol(image, name)
                        }
                    }!!
                val probe = AppKitProtocolProbe(function)
                UiHost(
                    onRootError = { _, e -> throw e },
                    handler = { h, a, e -> probe.event(h, a, e) }
                )
                    .use { host -> Application().run(host) }
                assertTrue(probe.finished)
            } finally {
                closeEditorProbe(image)
            }
        }
    }
}

private class AppKitProtocolProbe(val run: FunPtr<(Ptr<Unit>, Int) -> Int>) {
    val editor = CodeEditorState(CodeDocument("一\r\nA🙂B\r\n末"))
    var finished = false
    private var window: Window? = None
    private val deadline = MonotonicTimeSource.now() + Duration.seconds(15L)
    private var stage = 0
    private var queued = false

    fun event(host: UiHost, app: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                editor.setSelections([CodeSelection.caret(10L)])
                editor.onViewportChange { _ -> app.proxy().post { _ -> Unit } }
                val w = app
                    .createWindow(
                        windowAttributes {
                            title = "Scoop AppKit text protocol";
                            size = LogicalSize(420.0, 180.0);
                            visible = false
                        }
                    )
                window = Some(w)
                host.attach(w, { mount -> AppKitEditorRoot(editor, mount) })
                w.setVisible(true)
                w.requestFocus()
                app
                    .setControlFlow(
                        ControlFlow
                            .WaitUntil(MonotonicTimeSource.now() + Duration.milliseconds(30L))
                    )
            }

            case AboutToWait -> {
                val host = editor.mounted ?: return
                val frame = host.currentFrame() ?: return
                if (queued || finished || frame.document.version != editor.document.version) return
                if (stage > 0 && (host.connection == None || !host.area.isFocusActive)) return
                if (stage == 1 && host.area.visibleCaretBounds == None) return
                if (stage == 2 && !host.input.composing) return
                if (stage == 3 && (host.input.composing || editor.document.version != 1L)) return
                if (stage == 4 && editor.selections.primary.range != Utf8Range(0L, 5L)) return
                queued = true
                app
                    .proxy()
                    .post { active ->
                        queued = false;
                        advance(active)
                    }
            }

            case NewEvents(StartCause.Deadline) -> {
                if (!finished && MonotonicTimeSource.now() >= deadline) {
                    val ink = editor.mounted
                    val accepted = ink?.accepted ?: None
                    val rows = accepted?.rows?.size ?: -1L
                    val mounted = ink?.ended == Some(false)
                    val focused = editor.hasFocus
                    println(
                        f"AppKit timeout ${stage} mounted=${mounted} rows=${rows} focused=${
                            focused
                        }"
                    )
                    fail(
                        Some(
                            f"AppKit protocol stopped at stage ${stage}, mounted ${mounted}, rows ${
                                rows
                            }, focused ${focused}"
                        )
                    )
                }
                app
                    .setControlFlow(
                        ControlFlow
                            .WaitUntil(MonotonicTimeSource.now() + Duration.milliseconds(30L))
                    )
            }

            else -> {}
        }
    }

    private fun advance(app: ActiveApplication) {
        if (stage == 0) {
            assertTrue(editor.requestFocus())
        } else {
            @Unsafe {
                val lease = window!!.acquireNativeWindow()
                try {
                    when (lease.handle) {
                        case AppKit(_, val view) -> {
                            val result = run(view, stage - 1)
                            assertEquals(
                                0,
                                result,
                                Some(f"AppKit probe phase ${stage}, diagnostic ${result}")
                            )
                        }
                    }
                } finally {
                    lease.close()
                }
            }
            if (stage == 2) assertEquals(0L, editor.document.version)
            if (stage == 4) {
                finished = true;
                app.requestExit()
            }
        }
        stage += 1
    }
}

private class AppKitEditorRoot(val editor: CodeEditorState, scope: ComponentScope) :
    Component(scope) {
    public override fun render(): View = codeEditor(editor)
}
