package scoop.ui.editor

import scoop.graphics.*
import scoop.graphics.text.TextPosition
import scoop.platform.time.MonotonicTimeSource
import scoop.surface.*
import scoop.test.*
import scoop.text.repeat
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.component.*
import scoop.window.*

@Test
private class NativeEditorWindowTests {
    @Test(useProcess = true)
    fun splitEditorsPaintHitTestScrollAndShareEdits() {
        val p = NativeWindowProbe()
        UiHost(
            onRootError = { _, error -> throw error },
            handler = { host, app, event -> p.event(host, app, event) }
        )
            .use { host -> Application().run(host) }
        assertTrue(p.finished)
    }
}

private class NativeWindowProbe {
    private val original = "中\t🙂 abc אבג 123\r\n" + "short row\n".repeat(250L)
    val doc = CodeDocument(original)
    val left = CodeEditorState(doc)
    val right = CodeEditorState(doc)
    var finished = false
    private var stage = 0
    private var queued = false
    private var native: Window? = None
    private val deadline = MonotonicTimeSource.now() + Duration.seconds(30L)

    fun event(host: UiHost, app: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                left.onViewportChange { _ -> app.proxy().post { _ -> Unit } }
                right.onViewportChange { _ -> app.proxy().post { _ -> Unit } }
                val window = app
                    .createWindow(
                        windowAttributes {
                            title = "Scoop code editor validation";
                            size = LogicalSize(640.0, 260.0);
                            level = WindowLevel.AlwaysOnTop
                        }
                    )
                native = Some(window)
                host.attach(window, { mount -> ProbeEditors(this, mount) })
                window.requestFocus()
                app
                    .setControlFlow(
                        ControlFlow
                            .WaitUntil(MonotonicTimeSource.now() + Duration.milliseconds(50L))
                    )
            }

            case AboutToWait ->
                if (!queued && !finished) {
                    val l = left.mounted ?: return
                    val r = right.mounted ?: return
                    val lf = l.currentFrame() ?: return
                    val rf = r.currentFrame() ?: return
                    if (lf.document.version != doc.version || rf.document.version != doc.version)
                        return
                    if (stage ==
                        2 &&
                        right.caretRect(TextPosition(doc.lineRange(180L).start)) ==
                        None
                    )
                        return
                    queued = true
                    app
                        .proxy()
                        .post { active ->
                            queued = false;
                            advance(active)
                        }
                }

            case NewEvents(StartCause.Deadline) -> {
                if (MonotonicTimeSource.now() < deadline) {
                    if (stage == 0) native?.requestRedraw()
                    app
                        .setControlFlow(
                            ControlFlow
                                .WaitUntil(MonotonicTimeSource.now() + Duration.milliseconds(50L))
                        )
                    return
                }
                if (!finished) {
                    val l = left.mounted
                    val r = right.mounted
                    val leftFrame = l?.accepted ?: None
                    val rightFrame = r?.accepted ?: None
                    val leftRows = leftFrame?.rows?.size ?: -1L
                    val rightRows = rightFrame?.rows?.size ?: -1L
                    val mounted = l?.ended == Some(false)
                    fail(
                        Some(
                            f"editor window stopped at stage ${stage}, mounted ${
                                mounted
                            }, accepted rows ${leftRows}/${rightRows}"
                        )
                    )
                };
                app.requestExit()
            }

            else -> {}
        }
    }

    private fun advance(app: ActiveApplication) {
        val ink = left.mounted!!
        val frame = ink.currentFrame()!!
        when (stage) {
            case 0 -> {
                assertTrue(frame.rows.size > 0L && frame.rows.size < 40L)
                assertEquals(0L, left.visibleRanges()[0L].start)
                val caret = frame.displayCaret(TextPosition(4L))!!
                val hit = frame.hit(Point(caret.x, caret.y + caret.height / 2.0))!!
                assertEquals(4L, hit.byteOffset)
                assertTrue(left.caretRect(TextPosition(4L)) != None)
                assertTrue(left.requestFocus())
                left.setSelections([CodeSelection.caret(3L)])
                left.replaceSelections("😀")
                assertTrue(right.mounted!!.currentFrame()?.document?.version == None)
                stage = 1
            }

            case 1 -> {
                assertEquals("中😀\t🙂 abc אבג 123", doc.read(doc.lineRange(0L)))
                assertEquals(original.byteLength + 4L, right.mounted!!.semanticValue.byteLength)
                assertEquals(CodeEditResult.Applied, right.undo())
                assertEquals(original, doc.read(Utf8Range(0L, doc.byteLength)))
                right.options = CodeEditorOptions(softWrap = true)
                right
                    .decorations()
                    .set(
                        [
                            CodeDecoration(
                                Utf8Range(0L, doc.byteLength),
                                CodeDecorationStyle(gutter = Some(Color.Black))
                            )
                        ]
                    )
                right.revealRange(doc.lineRange(180L))
                stage = 2
            }

            case 2 -> {
                assertTrue(right.scroll.offset.y > 0.0)
                assertEquals(0.0, left.scroll.offset.y)
                assertTrue(right.visibleRanges()[0L].start > 0L)
                assertTrue(right.caretRect(TextPosition(0L)) == None)
                assertGutterClipped(right.mounted!!)
                finished = true
                app.requestExit()
            }

            else -> {}
        }
    }
}

private fun assertGutterClipped(ink: EditorInk) {
    val frame = ink.currentFrame()!!
    val pad = 40
    val height = frame.size.height.toInt()
    val width = frame.gutter.toInt() + 1
    assertTrue(frame.rows[0L].top < frame.origin.y)
    assertTrue(frame.rows[frame.rows.size - 1L].top >= frame.origin.y + frame.size.height)

    RasterSurface(width, height + pad * 2)
        .use { surface ->
            surface
                .draw { canvas ->
                    canvas.clear(Color.Transparent)
                    canvas.translate(0.0, pad.toDouble())
                    paintGutter(canvas, frame, ink)
                }
            val pixels = surface.readPixels()
            var hasLineNumbers = false
            for (y in 0..<surface.height) {
                // A fractional bottom edge can cover part of one raster pixel.
                if (y == pad + height && frame.size.height > height.toDouble()) continue
                val visible = y >= pad && y < pad + height
                val offset = (y * width * 4).toLong()
                // The document-wide gutter mark must reach both edges of the viewport.
                val stripe = pixels[offset + 2L * 4L + 3L]
                assertEquals(visible, stripe != 0.toByte(), Some(f"gutter mark at y=${y}"))
                for (x in 4..<width) {
                    if (pixels[offset + x.toLong() * 4L + 3L] == 0.toByte()) continue
                    assertTrue(visible, Some(f"line number outside the viewport at (${x}, ${y})"))
                    hasLineNumbers = true
                }
            }
            assertTrue(hasLineNumbers)
        }
}

private class ProbeEditors(private val probe: NativeWindowProbe, scope: ComponentScope) :
    Component(scope) {
    public override fun render(): View {
        val p = probe;
        return row {
            alignment = CrossAlignment.Stretch
            item(codeEditor(p.left)) { grow = 1.0 }
            item(codeEditor(p.right)) { grow = 1.0 }
        }
    }
}
